#!/bin/bash
mkdir -p "$(direnv_layout_dir)"
nixOverrides=()

if [ -d "$HOME/src/scripts/my-nix" ]; then nixOverrides+=(--override-input my-nix "path:$HOME/src/scripts/my-nix"); fi
export NIX_OVERRIDES=$(IFS=, echo "${nixOverrides[*]}")
# crates.io 403s Nix's default fetcher UA; identify so registry downloads succeed
export NIX_CURL_FLAGS='-A "nix-fetch/1.0"'
# shellcheck disable=SC2068
use flake . --show-trace --impure --refresh ${NIX_OVERRIDES[@]}
