{
  "name": "web-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Linear-style web design system: Panda CSS tokens, Ark UI headless primitives, Solid + Astro components.",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.ts",
    "./components": "./src/components/styled/index.ts",
    "./headless": "./src/components/headless/index.ts",
    "./icons": "./src/icons/index.tsx",
    "./styles.css": "./src/styles/index.css",
    "./astro/*": "./src/components/styled/*",
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "codegen": "panda codegen",
    "prepare": "panda codegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.39.2",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-solid": "^1.47.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.1",
    "@pandacss/preset-panda": "^1.12.1",
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1"
  }
}
