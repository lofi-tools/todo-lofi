---
import { css } from '../../../../styled-system/css'
import { Sparkles, User } from '../../../icons'
import type { ChatMessage } from './types'

interface Props {
  message: ChatMessage
  /**
   * Put the user's rows on the opposite side of the agent's, so a thread reads
   * as a back-and-forth rather than a stack of identical left-hand rows.
   */
  alternate?: boolean
}

const { message, alternate = false } = Astro.props

const isUser = message.role === 'user'
const flipped = alternate && isUser

const row = css({
  display: 'flex',
  gap: '3',
  alignItems: 'flex-start',
  flexDirection: flipped ? 'row-reverse' : 'row',
})

const avatar = css({
  display: 'grid',
  placeItems: 'center',
  w: '7',
  h: '7',
  borderRadius: 'md',
  flexShrink: '0',
  bg: message.role === 'agent' ? 'accent.subtle' : 'surface.hover',
  color: message.role === 'agent' ? 'accent' : 'fg.muted',
})

// `flex: 1` gives every message the same body width, and the bubble caps that
// width, so two messages from the same speaker line up regardless of how much
// text they carry.
const body = css({ flex: '1', minW: '0' })
const byline = css({
  display: 'flex',
  alignItems: 'center',
  justifyContent: flipped ? 'flex-end' : 'flex-start',
  gap: '2',
  mb: '1',
})
const author = css({ fontSize: 'sm', fontWeight: 'medium', color: 'fg.default' })
const meta = css({ fontSize: '2xs', color: 'fg.subtle' })
const text = css({
  fontSize: 'sm',
  color: 'fg.muted',
  lineHeight: 'relaxed',
  bg: 'surface.subtle',
  borderWidth: 'hairline',
  borderStyle: 'solid',
  borderColor: 'border',
  borderRadius: 'md',
  p: '3',
  maxW: '80%',
  ml: flipped ? 'auto' : undefined,
})
---

<div class={row}>
  <span class={avatar}>
    {message.role === 'agent' ? <Sparkles size={13} /> : <User size={13} />}
  </span>
  <div class={body}>
    <div class={byline}>
      <span class={author}>{message.author}</span>
      {message.meta && <span class={meta}>{message.meta}</span>}
    </div>
    <p class={text}>{message.text}</p>
  </div>
</div>
