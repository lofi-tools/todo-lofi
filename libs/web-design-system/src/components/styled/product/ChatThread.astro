---
import { css } from '../../../../styled-system/css'
import ChatMessageRow from './ChatMessageRow.astro'
import type { ChatMessage } from './types'

interface Props {
  messages: ChatMessage[]
  /**
   * Drop the thread's own panel (background and padding) and render the rows
   * directly, so the caller's layout owns the framing.
   */
  bare?: boolean
  /** Agent rows sit left; the user's answer them from the right. */
  alternate?: boolean
}

const { messages, bare = false, alternate = false } = Astro.props

const panel = css({ display: 'flex', flexDirection: 'column', gap: '3', p: '4', bg: 'canvas' })
---

{
  bare ? (
    messages.map((message, index) => (
      <ChatMessageRow
        message={message}
        alternate={alternate}
        spaced={index < messages.length - 1}
      />
    ))
  ) : (
    <div class={panel}>
      {messages.map((message) => (
        <ChatMessageRow message={message} alternate={alternate} />
      ))}
    </div>
  )
}
