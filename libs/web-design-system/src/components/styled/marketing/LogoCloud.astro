---
import { css } from '../../../../styled-system/css'

interface Props {
  title: string
  logos: string[]
}

const { title, logos } = Astro.props
---

<section class={css({ py: { base: '12', md: '16' } })}>
  <div
    class={css({
      w: '100%',
      maxW: '1200px',
      mx: 'auto',
      px: { base: '5', md: '8' },
      textAlign: 'center',
    })}
  >
    <p
      class={css({
        fontSize: '2xs',
        fontWeight: 'semibold',
        letterSpacing: 'wider',
        textTransform: 'uppercase',
        color: 'fg.subtle',
      })}
    >
      {title}
    </p>
    <ul
      class={css({
        display: 'grid',
        gridTemplateColumns: { base: 'repeat(2, 1fr)', sm: 'repeat(3, 1fr)', md: 'repeat(5, 1fr)' },
        gap: '6',
        listStyle: 'none',
        p: '0',
        mt: '8',
        alignItems: 'center',
      })}
    >
      {
        logos.map((logo) => (
          <li
            class={css({
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              h: '10',
              fontSize: 'lg',
              fontWeight: 'semibold',
              letterSpacing: 'tight',
              color: 'fg.subtle',
              transitionProperty: 'color',
              transitionDuration: 'fast',
              _hover: { color: 'fg.muted' },
            })}
          >
            {logo}
          </li>
        ))
      }
    </ul>
  </div>
</section>
