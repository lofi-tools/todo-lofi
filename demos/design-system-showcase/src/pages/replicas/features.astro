---
import { css } from 'styled-system/css'
import Base from '../../layouts/Base.astro'
import FeatureSection from 'web-design-system/astro/marketing/FeatureSection.astro'
import CTASection from 'web-design-system/astro/marketing/CTASection.astro'
import KanbanBoard from 'web-design-system/astro/product/KanbanBoard.astro'
import Timeline from 'web-design-system/astro/product/Timeline.astro'
import ChatThread from 'web-design-system/astro/product/ChatThread.astro'
import DiffViewer from 'web-design-system/astro/product/DiffViewer.astro'
import { featureSections, kanban, timelineRows, timelineMonths, chat, diffBefore, diffAfter } from '../../data/placeholder'
---

<Base title="Features" description="A Linear-style features replica with placeholder content.">
  <section class={css({ pt: { base: '16', md: '20' }, pb: { base: '8', md: '10' } })}>
    <div class={css({ maxW: '760px', mx: 'auto', px: { base: '5', md: '8' }, textAlign: 'center' })}>
      <h1 class={css({ textStyle: 'display', color: 'fg.default' })}>Features</h1>
      <p class={css({ textStyle: 'body.lg', color: 'fg.muted', mt: '4' })}>
        Everything a modern product team needs, from intake to ship. Placeholder copy throughout.
      </p>
    </div>
  </section>

  <FeatureSection
    eyebrow={featureSections[0].eyebrow}
    title={featureSections[0].title}
    description={featureSections[0].description}
    href="/replicas/features"
  >
    <KanbanBoard columns={kanban} compact />
  </FeatureSection>

  <FeatureSection
    eyebrow={featureSections[1].eyebrow}
    title={featureSections[1].title}
    description={featureSections[1].description}
    href="/replicas/features"
    reverse
  >
    <Timeline months={timelineMonths} rows={timelineRows} />
  </FeatureSection>

  <FeatureSection
    eyebrow={featureSections[2].eyebrow}
    title={featureSections[2].title}
    description={featureSections[2].description}
    href="/replicas/features"
  >
    <ChatThread messages={chat} />
  </FeatureSection>

  <FeatureSection
    eyebrow={featureSections[3].eyebrow}
    title={featureSections[3].title}
    description={featureSections[3].description}
    href="/replicas/features"
    reverse
  >
    <DiffViewer filename="src/screens/HomeScreen.tsx" before={diffBefore} after={diffAfter} />
  </FeatureSection>

  <CTASection title="Built for the future. Available today." />
</Base>
