---
import { css } from "styled-system/css";
import { ChevronDown, ArrowRight, Download } from "web-design-system/icons";
import { FORMATS, ARCHES, PLATFORMS, RELEASES_URL, primaryArch } from "../../../data/downloads";

const group = css({ position: "relative", display: "inline-flex", alignItems: "stretch" });

const primary = css({
  display: "inline-flex",
  alignItems: "center",
  h: "10",
  px: "5",
  borderTopLeftRadius: "sm",
  borderBottomLeftRadius: "sm",
  bg: "accent",
  color: "fg.onAccent",
  fontSize: "md",
  fontWeight: "medium",
  whiteSpace: "nowrap",
  _hover: { bg: "accent.hover" },
  _focusVisible: { outline: "none", boxShadow: "focus" },
});

const divider = css({ w: "1px", alignSelf: "stretch", bg: "rgba(255,255,255,0.25)" });

const toggle = css({
  display: "inline-flex",
  alignItems: "center",
  justifyContent: "center",
  w: "9",
  h: "10",
  borderTopRightRadius: "sm",
  borderBottomRightRadius: "sm",
  bg: "accent",
  color: "fg.onAccent",
  cursor: "pointer",
  _hover: { bg: "accent.hover" },
  _focusVisible: { outline: "none", boxShadow: "focus" },
});

const menu = css({
  position: "absolute",
  top: "100%",
  right: "0",
  mt: "1",
  minW: "60",
  p: "1",
  display: "flex",
  flexDirection: "column",
  borderRadius: "md",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border",
  bg: "surface.elevated",
  boxShadow: "md",
  zIndex: "popover",
  "&[hidden]": { display: "none" },
});

const platformRow = css({
  display: "flex",
  alignItems: "center",
  justifyContent: "space-between",
  gap: "6",
  px: "3",
  py: "1.5",
  borderRadius: "sm",
  fontSize: "sm",
  color: "fg.default",
  whiteSpace: "nowrap",
});

const platformLabel = css({ display: "inline-flex", alignItems: "center", gap: "2", fontWeight: "medium" });

const archBadge = css({
  fontFamily: "mono",
  fontSize: "2xs",
  fontWeight: "normal",
  color: "fg.subtle",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border",
  borderRadius: "sm",
  px: "1.5",
  py: "0.5",
});

const formatButtons = css({ display: "inline-flex", alignItems: "center", gap: "1.5" });

const formatButton = css({
  display: "inline-flex",
  alignItems: "center",
  gap: "1",
  h: "7",
  px: "2",
  borderRadius: "sm",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border",
  fontSize: "xs",
  color: "fg.muted",
  whiteSpace: "nowrap",
  transitionProperty: "color, background-color, border-color",
  transitionDuration: "fast",
  _hover: { bg: "surface.hover", color: "fg.default", borderColor: "border.strong" },
  _focusVisible: { outline: "none", boxShadow: "focus" },
  // The longest label (.AppImage) leaves no slack in the row: without this
  // the icon, a shrinkable flex item, collapses to zero width.
  "& svg": { flexShrink: "0" },
});

const menuItemLast = css({
  display: "flex",
  alignItems: "center",
  justifyContent: "flex-end",
  gap: "6",
  px: "3",
  h: "8",
  borderRadius: "sm",
  fontSize: "sm",
  color: "fg.subtle",
  textDecoration: "underline",
  textUnderlineOffset: "2px",
  whiteSpace: "nowrap",
  transitionProperty: "color, background-color",
  transitionDuration: "fast",
  _hover: { bg: "surface.hover", color: "fg.default" },
  _focusVisible: { outline: "none", boxShadow: "focus" },
});

const menuLabelWithArrow = css({
  display: "inline-flex",
  alignItems: "center",
  gap: "1.5",
});
---

<div class={group} data-download-button>
  <a data-download data-platform="auto" data-download-primary href={RELEASES_URL} class={primary}>
    <span data-download-primary-label>Download for your platform</span>
  </a>
  <span class={divider} aria-hidden="true"></span>
  <button
    type="button"
    class={toggle}
    data-download-menu-toggle
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Other downloads"
  >
    <ChevronDown size={16} />
  </button>
  <div class={menu} data-download-menu role="menu" hidden>
    {
      PLATFORMS.map((platform) => (
        <div class={platformRow}>
          <span class={platformLabel}>
            {platform.label}
            {ARCHES[platform.id].filter((arch) => arch.available).map((arch) => (
              <span class={archBadge}>{arch.label}</span>
            ))}
          </span>
          <span class={formatButtons}>
            <a
              class={formatButton}
              data-download
              data-platform={platform.id}
              data-arch={primaryArch(platform.id).id}
              data-format={FORMATS[platform.id][0].id}
              href={RELEASES_URL}
              title={`${platform.label} (${primaryArch(platform.id).label}): ${FORMATS[platform.id][0].hint}`}
            >
              <Download size={12} />
              {FORMATS[platform.id][0].label}
            </a>
          </span>
        </div>
      ))
    }
    <a class={menuItemLast} role="menuitem" href="/downloads#all-downloads">
      <span class={menuLabelWithArrow}>
        All downloads
        <ArrowRight size={14} />
      </span>
    </a>
  </div>
</div>

<script>
  import { initDownloads } from "../../../data/downloads";

  void initDownloads();

  for (const button of document.querySelectorAll<HTMLElement>("[data-download-button]")) {
    const toggle = button.querySelector<HTMLElement>("[data-download-menu-toggle]");
    const menu = button.querySelector<HTMLElement>("[data-download-menu]");
    if (!toggle || !menu) continue;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(menu.hidden));
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !button.contains(event.target)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
