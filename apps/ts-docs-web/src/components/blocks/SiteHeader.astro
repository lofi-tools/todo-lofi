---
import { css } from 'styled-system/css'
import ThemeToggle from 'web-design-system/astro/ThemeToggle.astro'
import { GitHub, Menu, X } from 'web-design-system/icons'
import { REPO_URL } from '../../data/docs'

interface Props {
  /** Align the nav to the homepage blueprint's content column. */
  blueprint?: boolean
}

const { blueprint = false } = Astro.props

const links = [
  { label: 'Docs', href: '/docs' },
  { label: 'Download', href: '/downloads' },
  { label: 'Roadmap', href: '/roadmap' },
]

// This header serves the landing page, the downloads page, and the roadmap, so
// each link marks itself current and the brand link is only current on `/`.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isHome = path === '/'

const linkStyle = (active: boolean) =>
  css({
    display: 'inline-flex',
    alignItems: 'center',
    h: '8',
    px: '3',
    borderRadius: 'sm',
    fontSize: 'sm',
    color: active ? 'fg.default' : 'fg.muted',
    bg: active ? 'surface.hover' : 'transparent',
    fontWeight: active ? 'medium' : 'normal',
    transitionProperty: 'color, background-color',
    transitionDuration: 'fast',
    _hover: { color: 'fg.default', bg: 'surface.hover' },
    _focusVisible: { outline: 'none', boxShadow: 'focus' },
  })

// The hamburger, and the drawer it opens, only exist below `sm`: from there up
// the links are already in the nav.
const menuButton = css({
  display: { base: 'inline-flex', sm: 'none' },
  alignItems: 'center',
  justifyContent: 'center',
  w: '8',
  h: '8',
  p: '0',
  // The page's reset does not cover buttons, so clear the UA chrome by hand.
  borderWidth: '0',
  bg: 'transparent',
  borderRadius: 'sm',
  color: 'fg.muted',
  cursor: 'pointer',
  transitionProperty: 'color, background-color',
  transitionDuration: 'fast',
  _hover: { color: 'fg.default', bg: 'surface.hover' },
  _focusVisible: { outline: 'none', boxShadow: 'focus' },
})

// The toggle shows a hamburger and swaps to an X while open. The button carries
// `aria-expanded`, so the swap needs no script.
const menuGlyph = css({
  display: 'inline-flex',
  'button[aria-expanded="true"] &': { display: 'none' },
})
const closeGlyph = css({
  display: 'none',
  'button[aria-expanded="true"] &': { display: 'inline-flex' },
})

/**
 * The drawer slides open by growing its grid row from `0fr` to `1fr` — the one
 * transition that animates to a content height. The inner element clips the
 * content (`min-height: 0`) so nothing shows while the row is collapsed, and
 * the list fades in behind the slide. The hairline only colours once open, so
 * the closed drawer leaves no line under the nav.
 */
const drawer = css({
  display: { base: 'grid', sm: 'none' },
  gridTemplateRows: '0fr',
  overflow: 'hidden',
  borderTopWidth: 'hairline',
  borderTopStyle: 'solid',
  borderTopColor: 'transparent',
  transitionProperty: 'grid-template-rows, border-color',
  transitionDuration: 'normal',
  transitionTimingFunction: 'standard',
  '&[data-open]': { gridTemplateRows: '1fr', borderTopColor: 'border.subtle' },
})

const drawerInner = css({ minH: '0', overflow: 'hidden' })

const drawerList = css({
  display: 'flex',
  flexDirection: 'column',
  gap: '0.5',
  px: '5',
  pt: '1',
  pb: '4',
  opacity: '0',
  transform: 'translateY(-4px)',
  transitionProperty: 'opacity, transform',
  transitionDuration: 'normal',
  transitionTimingFunction: 'standard',
  '[data-open] &': { opacity: '1', transform: 'translateY(0)' },
})

const drawerLink = (active: boolean) =>
  css({
    display: 'flex',
    alignItems: 'center',
    h: '10',
    px: '3',
    borderRadius: 'sm',
    fontSize: 'sm',
    color: active ? 'fg.default' : 'fg.muted',
    bg: active ? 'surface.hover' : 'transparent',
    fontWeight: active ? 'medium' : 'normal',
    transitionProperty: 'color, background-color',
    transitionDuration: 'fast',
    _hover: { color: 'fg.default', bg: 'surface.hover' },
    _focusVisible: { outline: 'none', boxShadow: 'focus' },
  })
---

<header
  data-header-drawer
  class={css({
    position: 'sticky',
    top: '0',
    zIndex: 'sticky',
    w: 'full',
    borderBottomWidth: 'hairline',
    // The other sides default to `medium` (3px) once the style is set.
    borderTopWidth: '0',
    borderStyle: 'solid',
    borderColor: 'border.subtle',
    backdropFilter: 'blur(12px)',
    backgroundColor: 'rgba(8, 9, 10, 0.72)',
    _light: { backgroundColor: 'rgba(255, 255, 255, 0.78)' },
  })}
>
  <nav
    aria-label="Main"
    class={css({
      display: 'flex',
      alignItems: 'center',
      gap: '4',
      h: '14',
      w: '100%',
      maxW: blueprint ? '1104px' : '1280px',
      mx: 'auto',
      px: { base: '5', md: '8' },
    })}
  >
    <a
      href="/"
      aria-current={isHome ? 'page' : undefined}
      class={css({
        display: 'inline-flex',
        alignItems: 'center',
        gap: '2',
        fontWeight: 'semibold',
        letterSpacing: 'tight',
        color: 'fg.default',
        flexShrink: '0',
        _focusVisible: { outline: 'none', boxShadow: 'focus' },
      })}
    >
      <img
        src="/favicon.svg"
        alt=""
        width="20"
        height="20"
        class={css({
          borderRadius: 'xs',
          boxShadow: '0 0 0 0.25px rgba(255, 255, 255, 0.65)',
          _light: { boxShadow: '0 0 0 0.25px rgba(0, 0, 0, 0.35)' },
        })}
      />
      <span>Taskstream</span>
    </a>

    <div class={css({ flex: '1' })} />

    <ul
      class={css({
        display: { base: 'none', sm: 'flex' },
        alignItems: 'center',
        gap: '0.5',
        listStyle: 'none',
        m: '0',
        p: '0',
      })}
    >
      {
        links.map((link) => (
          <li>
            <a
              class={linkStyle(path === link.href)}
              href={link.href}
              aria-current={path === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={REPO_URL}
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub repository"
      class={css({
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        w: '8',
        h: '8',
        borderRadius: 'sm',
        color: 'fg.muted',
        transitionProperty: 'color, background-color',
        transitionDuration: 'fast',
        _hover: { color: 'fg.default', bg: 'surface.hover' },
        _focusVisible: { outline: 'none', boxShadow: 'focus' },
      })}
    >
      <GitHub size={18} />
    </a>
    <ThemeToggle />

    <button
      type="button"
      data-drawer-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Menu"
      class={menuButton}
    >
      <span class={menuGlyph}>
        <Menu size={18} />
      </span>
      <span class={closeGlyph}>
        <X size={18} />
      </span>
    </button>
  </nav>

  <!--
    The mobile drawer: the same three links as a stacked list, opened by the
    hamburger. It stays out of reach while collapsed (`inert`, set by the
    script), and the nav's own links take over at `sm`.
  -->
  <div id="site-menu" data-drawer-panel class={drawer}>
    <div class={drawerInner}>
      <ul class={drawerList}>
        {
          links.map((link) => (
            <li>
              <a
                class={drawerLink(path === link.href)}
                href={link.href}
                aria-current={path === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  import { startHeaderDrawers } from './headerDrawer'

  startHeaderDrawers()
</script>
