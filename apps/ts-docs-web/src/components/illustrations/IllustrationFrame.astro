---
import { css } from "styled-system/css";
import { dot, windowBar, windowSurface } from "./styles";

interface Props {
  /** Name shown in the window bar; the bar is the illustration's chrome. */
  title?: string;
  /**
   * Window chrome. `titled` draws the header bar: the two handle buttons and,
   * when a name is given, the title. `plain` drops the header entirely and
   * leaves only the two handle buttons, for windows that need no label.
   */
  chrome?: "titled" | "plain";
  /**
   * Whether the body pads itself. Turn it off for content that brings its own
   * padding, such as a pane replica.
   */
  pad?: boolean;
}

const { title, chrome = "titled", pad = true } = Astro.props;

/**
 * The headerless chrome: the two handle buttons with no title and no hairline
 * under them, so the panel reads as a bare window rather than a titled one.
 */
const handleBar = css({
  display: "flex",
  alignItems: "center",
  gap: "1.5",
  flexShrink: "0",
  px: "3",
  pt: "3",
});

const root = css({
  display: "flex",
  flexDirection: "column",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  overflow: "hidden",
});

const titleStyle = css({ ml: "2", fontFamily: "mono", fontSize: "2xs", color: "fg.subtle" });

const body = css({ display: "flex", flexDirection: "column", gap: "2", flex: "1" });
const paddedBody = css({ p: "3" });
---

<div class={`${root} ${windowSurface}`}>
  {chrome === "plain" ? (
    <div class={handleBar}>
      <span class={dot} />
      <span class={dot} />
    </div>
  ) : (
    <div class={windowBar}>
      <span class={dot} />
      <span class={dot} />
      {title && <span class={titleStyle}>{title}</span>}
    </div>
  )}
  <div class={pad ? `${body} ${paddedBody}` : body}>
    <slot />
  </div>
</div>
