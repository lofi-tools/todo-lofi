---
import { css } from "styled-system/css";
import AppMockup from "./AppMockup.astro";
import MobileMockup from "./MobileMockup.astro";
import PlaceholderList from "./PlaceholderList.astro";
import { paneLabel, threadLayer, threadNode, threadPath, windowSurface } from "./styles";

/**
 * A cut-down desktop list for the "centered on you" story: the tags navbar
 * and a simplified main pane. Two tags reach out of the app — #work to a
 * company list, #life admin to the same list on a phone — with a loose thread
 * drawn from each tag row to the surface it lives on.
 */
// Containment only: the illustration's own windows carry its surface, so the
// root stays transparent and borderless and the threads have a positioning
// context to measure against.
const root = css({
  position: "relative",
  display: "flex",
  flexDirection: { base: "column", md: "row" },
  gap: "3",
  alignItems: "stretch",
});

const tags = [
  { name: "#inbox" },
  { name: "#work", thread: "work" },
  { name: "#life admin", thread: "life" },
  { name: "#home" },
];

/**
 * The external surfaces sit in a column beside the app, targets for the
 * threads. Fixed width so the handset keeps its proportions; centered when the
 * layout stacks.
 */
const side = css({
  display: "flex",
  flexDirection: "column",
  gap: "3",
  w: "112px",
  flexShrink: "0",
  alignSelf: { base: "center", md: "auto" },
});

const companyList = css({
  display: "flex",
  flexDirection: "column",
  gap: "1.5",
  p: "2",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
});

/**
 * The app window is nudged off the side column's edges — right and down a
 * little — so the blocks read as panels beside each other rather than snapping
 * to the same grid. A transform, not margins, so the shift does not change the
 * row's height or the side column's layout; only where they sit in a row, since
 * stacked the offset would just push the window out of the column.
 */
const appOffset = css({
  flex: "1",
  minW: "0",
  display: "flex",
  transform: { base: "none", md: "translate(10px, 12px)" },
});
---

<div class={root} data-threads>
  <div class={side}>
    <div class={`${companyList} ${windowSurface}`} data-thread-to="company">
      <span class={paneLabel}>company's tasklist</span>
      <PlaceholderList rows={2} />
    </div>

    <div data-thread-to="mobile">
      <MobileMockup caption="on mobile">
        <span class={paneLabel}>life admin</span>
        <PlaceholderList rows={5} spread />
      </MobileMockup>
    </div>
  </div>

  <div class={appOffset}>
    <AppMockup tags={tags} taskRows={4} />
  </div>

  <svg class={threadLayer} data-thread-svg aria-hidden="true">
    <g data-thread="work" data-from="work" data-to="company">
      <path class={threadPath} data-thread-path />
      <circle class={threadNode} r="2.5" data-thread-node />
      <circle class={threadNode} r="2.5" data-thread-node />
    </g>
    <g data-thread="life" data-from="life" data-to="mobile">
      <path class={threadPath} data-thread-path />
      <circle class={threadNode} r="2.5" data-thread-node />
      <circle class={threadNode} r="2.5" data-thread-node />
    </g>
  </svg>
</div>

<script>
  import { observeThreads } from "./threads";

  observeThreads();
</script>
