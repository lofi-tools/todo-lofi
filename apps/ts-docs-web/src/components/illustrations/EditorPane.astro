---
import { css } from "styled-system/css";
import { windowBar } from "./styles";

interface Segment {
  /** Bar width, in pixels. */
  w: number;
  /** One of the mock syntax colours, walking bordeaux → indigo. */
  tone: "bordeaux" | "crimson" | "magenta" | "purple" | "indigo" | "muted";
}

interface Props {
  /** File name shown in the editor's bar. */
  name: string;
  /** Code lines to render; the body clips whatever does not fit. */
  lines?: number;
}

const { name, lines = 10 } = Astro.props;

/** Cycled line shapes, so no two adjacent lines read the same. */
const patterns: Segment[][] = [
  [{ w: 34, tone: "bordeaux" }, { w: 22, tone: "muted" }],
  [{ w: 20, tone: "muted" }, { w: 64, tone: "crimson" }, { w: 22, tone: "magenta" }],
  [{ w: 46, tone: "purple" }, { w: 30, tone: "muted" }],
  [{ w: 58, tone: "magenta" }, { w: 18, tone: "indigo" }],
];

const rows = Array.from({ length: lines }, (_, index) => patterns[index % patterns.length]);

const fileName = css({ fontFamily: "mono", fontSize: "2xs", color: "fg.subtle" });

const body = css({
  flex: "1",
  minH: "0",
  display: "flex",
  flexDirection: "column",
  gap: "1.5",
  p: "2",
  overflow: "hidden",
  backgroundImage:
    "linear-gradient(170deg, token(colors.surface.subtle) 0%, token(colors.canvas) 100%)",
});

const codeLine = css({ display: "flex", alignItems: "center", gap: "1.5" });
const gutter = css({
  fontFamily: "mono",
  fontSize: "2xs",
  color: "fg.subtle",
  w: "3",
  textAlign: "right",
  flexShrink: "0",
});
const token = css({ h: "1.5", borderRadius: "full" });

/**
 * The mock syntax palette: one hue family from bordeaux through crimson,
 * magenta, and purple to the brand indigo, so a screen of code reads in the
 * product's own colours rather than a generic highlighter.
 */
const tint = {
  bordeaux: css({ bg: "#8f2d52" }),
  crimson: css({ bg: "#c04a63" }),
  magenta: css({ bg: "#c356d4" }),
  purple: css({ bg: "#9a6ce6" }),
  indigo: css({ bg: "#5e6ad2" }),
  muted: css({ bg: "border.strong" }),
};

/**
 * The editor pane: the open file's title over its code. It is not a window of
 * its own — the editor window around it carries the chrome — so it has no
 * border or surface, and it fills the pane it is handed.
 */
const root = css({
  flex: "1",
  minW: "0",
  display: "flex",
  flexDirection: "column",
  overflow: "hidden",
});
---

<div class={root}>
  <div class={windowBar}>
    <span class={fileName}>{name}</span>
  </div>
  <div class={body}>
    {
      rows.map((segments, index) => (
        <div class={codeLine}>
          <span class={gutter}>{index + 1}</span>
          {segments.map((segment) => (
            <span class={`${token} ${tint[segment.tone]}`} style={{ width: `${segment.w}px` }} />
          ))}
        </div>
      ))
    }
  </div>
</div>
