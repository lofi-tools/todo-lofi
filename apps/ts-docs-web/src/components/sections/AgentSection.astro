---
import HomepageSection from "./HomepageSection.astro";
import FeatureSection from "web-design-system/astro/marketing/FeatureSection.astro";
import ChatThread from "web-design-system/astro/product/ChatThread.astro";
import IllustrationStage from "../illustrations/IllustrationStage.astro";
import IllustrationFrame from "../illustrations/IllustrationFrame.astro";
import { agentThread } from "../../../data/landing";
---

<HomepageSection bare index={3} label="agent">
  <FeatureSection
    eyebrow="The AI agent"
    title="AI to refine a task description, split it into subtasks, then work on it by itself"
    description="The agent works in your existing lists: it adds and edits tasks, sets up repeats, and moves work through its stages."
    href="/docs/agent"
    linkLabel="Read about the agent"
    reverse
  >
    <IllustrationStage fade="none" tone="indigo">
      <IllustrationFrame title="agent">
        <ChatThread messages={agentThread} bare alternate />
      </IllustrationFrame>
    </IllustrationStage>
  </FeatureSection>
</HomepageSection>
