  { label: 'Quit and resume', href: '#quit' },
]

const states = [
  { state: 'draft', meaning: 'A prompt is being composed; no agent session or worktree exists yet.' },
  { state: 'starting', meaning: 'The first prompt was sent and the worktree or process is starting.' },
  { state: 'ready', meaning: 'The agent is idle and the task can take another prompt.' },
  { state: 'working', meaning: 'The agent is running a turn.' },
  { state: 'waiting', meaning: 'An approval or question needs a person.' },
  { state: 'review', meaning: 'A completed turn changed HEAD, the branch or the worktree diff.' },
  { state: 'done', meaning: 'The task was archived; its branch is kept.' },
  { state: 'failed / interrupted', meaning: 'The process failed, or the app stopped while the task was live.' },
]
