---
// Order matters: the generated Panda stylesheet declares the cascade layer
// order and the utility classes; the design system's own stylesheet then
// slots its reset/base into those layers (DESIGN.md §2).
import 'styled-system/styles.css'
import 'web-design-system/styles.css'
import '../styles/app.css'

interface Props {
  title: string
  description?: string
  /** What follows the title in the tab: `Shepherd · <suffix>`. */
  suffix?: string
  /** Favicon for pages with their own product mark. */
  icon?: string
}

const { title, description, suffix = 'Shepherd docs', icon = '/shepherd-logo.svg' } = Astro.props
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={icon} />
    <title>{title} · {suffix}</title>
    {description && <meta name="description" content={description} />}
    <!-- Set the theme before first paint so there is no flash. -->
    <script is:inline>
      ;(function () {
        try {
          var stored = localStorage.getItem('wds-theme')
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored
          }
        } catch (error) {
          /* storage unavailable: keep the dark default */
        }
      })()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
