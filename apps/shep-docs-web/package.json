{
  "name": "shep-docs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shepherd's documentation website, built with the web design system.",
  "scripts": {
    "codegen": "pnpm --filter web-design-system run codegen && panda codegen && panda cssgen --outfile styled-system/styles.css",
    "predev": "pnpm run codegen",
    "dev": "astro dev",
    "prebuild": "pnpm run codegen",
    "build": "astro build",
    "preview": "astro preview --port 4324",
    "typecheck": "pnpm run codegen && astro check",
    "e2e:cleanup": "astro preview stop || true",
    "e2e:server": "astro preview --port 4324",
    "test:e2e": "pnpm run e2e:cleanup && playwright test; status=$?; pnpm run e2e:cleanup; exit $status"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "astro": "^7.3.3",
    "solid-js": "^1.9.15",
    "web-design-system": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@pandacss/dev": "^1.12.1",
    "@pandacss/preset-panda": "^1.12.1",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "web-test-guards": "workspace:*"
  }
}
