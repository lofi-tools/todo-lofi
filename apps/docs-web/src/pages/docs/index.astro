---
import { css } from 'styled-system/css'
import Docs from '../../layouts/Docs.astro'
import Callout from 'web-design-system/astro/marketing/Callout.astro'
import { Badge } from 'web-design-system/components'
import screenshot from '../../assets/app.png'

const toc = [
  { label: 'What it is', href: '#what-it-is' },
  { label: 'Highlights', href: '#highlights' },
  { label: 'Your data stays yours', href: '#your-data-stays-yours' },
  { label: 'Where to start', href: '#where-to-start' },
]

const highlights = [
  {
    title: 'Integrated AI agent',
    href: '/docs/agent',
    status: 'Available',
    tone: 'success',
    body: 'A docked agent pane for doing work, not just answering questions: it can read and change your lists, set up repeats, and run a task through a whole workflow.',
  },
  {
    title: 'Tags, projects, and areas',
    href: '/docs/tasks',
    status: 'Available',
    tone: 'success',
    body: 'Group and filter tasks with nested tags, organize them into a tree of projects and areas, and reorder by drag and drop.',
  },
  {
    title: 'Repeat and scheduling',
    href: '/docs/repeats',
    status: 'Available',
    tone: 'success',
    body: 'Recurring tasks are configured in a dedicated picker instead of a syntax you have to remember.',
  },
  {
    title: 'Semi-automated workflows',
    href: '/docs/workflows',
    status: 'Available',
    tone: 'success',
    body: 'A task can carry a workflow. Coding tasks, for example, move through interview, spec, implement, review, and merge.',
  },
  {
    title: 'Two-way sync',
    href: '/docs/sync',
    status: 'Todoist · GitHub preview',
    tone: 'accent',
    body: 'Keep working in the task app you already use. Todoist sync is the current target; GitHub issues and projects are in preview.',
  },
  {
    title: 'Mini-apps (extensions)',
    href: '/docs/mini-apps',
    status: 'Some coming soon',
    tone: 'warning',
    body: 'Small purpose-built panes: travel checklist templates ship today; message follow-ups, birthday reminders, and job application tracking are planned.',
  },
] as const

const audiences = [
  {
    heading: 'Using the app',
    body: 'You want to run todo-lofi and get your tasks into it.',
    links: [
      { title: 'Install and run', href: '/docs/install', body: 'What you need, and how to run it from a checkout or build a macOS app.' },
      { title: 'Tasks, tags, and projects', href: '/docs/tasks', body: 'How the tree works, and what a task carries besides a title.' },
      { title: 'Feature status', href: '/docs/status', body: 'What is available, what is in preview, and what is only planned.' },
      { title: 'Configuration', href: '/docs/configuration', body: 'In-app settings, model providers, and connecting Todoist or GitHub.' },
    ],
  },
]
---

<Docs title="Overview" description="todo-lofi is a local-first task manager for macOS and Linux. Nested tags, an embedded AI agent pane, Todoist sync, and a keyboard-first workflow — all running offline." toc={toc}>
  <h2 id="what-it-is">What it is</h2>
  <p>
    <strong>todo-lofi</strong> is a task manager that keeps your lists on your own machine and stays
    fully usable with no network at all. Organize work into nested tags, projects, and areas; set
    repeats through a picker instead of memorizing syntax; hand work to the docked agent pane; and let
    long-running efforts carry their own staged workflows.
  </p>
  <p>
    Everything in the core loop — listing, editing, repeating, and reordering tasks — works offline and
    is driven from the keyboard. Network features are opt-in extras: connect Todoist or GitHub sync, or
    give the agent a model provider, and each one brings its own credentials without ever gating the
    task list itself.
  </p>

  <figure class={css({ m: '0', my: '6' })}>
    <img
      src={screenshot.src}
      width={screenshot.width}
      height={screenshot.height}
      alt="The todo-lofi desktop app: a task list on the left, task details in the middle, and the agent pane on the right."
      class={css({
        w: 'full',
        h: 'auto',
        borderRadius: 'lg',
        borderWidth: 'hairline',
        borderStyle: 'solid',
        borderColor: 'border',
        bg: 'surface.subtle',
      })}
    />
    <figcaption class={css({ mt: '2', fontSize: 'xs', color: 'fg.subtle' })}>
      The desktop app: task list, task details, and the agent pane.
    </figcaption>
  </figure>

  <h2 id="highlights">Highlights</h2>
  <ul class={css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: 'repeat(2, 1fr)' }, gap: '4', listStyle: 'none', p: '0', m: '0' })}>
    {
      highlights.map((highlight) => (
        <li>
          <a
            href={highlight.href}
            class={css({
              display: 'block',
              p: '5',
              borderRadius: 'lg',
              borderWidth: 'hairline',
              borderStyle: 'solid',
              borderColor: 'border',
              bg: 'surface.subtle',
              _hover: { borderColor: 'border.strong', bg: 'surface.elevated' },
              _focusVisible: { outline: 'none', boxShadow: 'focus' },
              transitionProperty: 'border-color, background-color',
              transitionDuration: 'fast',
            })}
          >
            <div class={css({ display: 'flex', alignItems: 'center', gap: '2', mb: '2', flexWrap: 'wrap' })}>
              <span class={css({ fontSize: 'md', fontWeight: 'semibold', color: 'fg.default' })}>
                {highlight.title}
              </span>
              <Badge tone={highlight.tone} variant="subtle">{highlight.status}</Badge>
            </div>
            <p class={css({ fontSize: 'sm', color: 'fg.muted', lineHeight: 'relaxed', m: '0' })}>
              {highlight.body}
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  <h2 id="your-data-stays-yours">Your data stays yours</h2>
  <p>
    Your tasks live on your machine, and that copy is the one the app trusts. Sync is a layer on top:
    when you connect an outside system, the app maps your tasks onto it and reconciles changes in both
    directions — but a sync that fails never breaks the list, and you keep working offline until it
    catches up.
  </p>
  <p>
    The same opt-in rule holds for the agent: nothing needs configuring to use the local lists, and the
    agent only starts working once you pick a provider and give it a key. See
    <a href="/docs/configuration">Configuration</a> for providers and accounts, and
    <a href="/docs/status">Feature status</a> for what is shipped versus planned.
  </p>

  <Callout tone="note" title="Working on the code?">
    How the workspace is laid out, which crate owns what, and how to run it all live in
    <a href="/docs/contributor">the contributor guide</a> — start with
    <a href="/docs/contributor/architecture">Architecture</a>.
  </Callout>

  <h2 id="where-to-start">Where to start</h2>
  {
    audiences.map((audience) => (
      <section class={css({ mb: '8' })}>
        <h3 class={css({ textStyle: 'h4', color: 'fg.default', mb: '1' })}>{audience.heading}</h3>
        <p class={css({ fontSize: 'sm', color: 'fg.muted', mt: '0', mb: '3' })}>{audience.body}</p>
        <ul class={css({ display: 'grid', gridTemplateColumns: { base: '1fr', sm: 'repeat(2, 1fr)' }, gap: '4', listStyle: 'none', p: '0', m: '0' })}>
          {
            audience.links.map((item) => (
              <li>
                <a
                  href={item.href}
                  class={css({
                    display: 'block',
                    p: '5',
                    borderRadius: 'lg',
                    borderWidth: 'hairline',
                    borderStyle: 'solid',
                    borderColor: 'border',
                    bg: 'surface.subtle',
                    _hover: { borderColor: 'border.strong', bg: 'surface.elevated' },
                    _focusVisible: { outline: 'none', boxShadow: 'focus' },
                    transitionProperty: 'border-color, background-color',
                    transitionDuration: 'fast',
                  })}
                >
                  <span class={css({ display: 'block', fontWeight: 'semibold', color: 'fg.default', mb: '1' })}>
                    {item.title}
                  </span>
                  <span class={css({ display: 'block', fontSize: 'sm', color: 'fg.muted', lineHeight: 'relaxed' })}>
                    {item.body}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    ))
  }
</Docs>
