---
import { css } from 'styled-system/css'
import Base from '../layouts/Base.astro'
import SiteHeader from '../components/SiteHeader.astro'
import DocsFooter from '../components/DocsFooter.astro'
import { Badge } from 'web-design-system/components'
import AnnouncementPill from 'web-design-system/astro/marketing/AnnouncementPill.astro'
import Hero from 'web-design-system/astro/marketing/Hero.astro'
import LogoCloud from 'web-design-system/astro/marketing/LogoCloud.astro'
import StatsBand from 'web-design-system/astro/marketing/StatsBand.astro'
import SectionHeading from 'web-design-system/astro/marketing/SectionHeading.astro'
import FeatureSection from 'web-design-system/astro/marketing/FeatureSection.astro'
import CTASection from 'web-design-system/astro/marketing/CTASection.astro'
import IssueRow from 'web-design-system/astro/product/IssueRow.astro'
import KanbanBoard from 'web-design-system/astro/product/KanbanBoard.astro'
import Timeline from 'web-design-system/astro/product/Timeline.astro'
import ChatThread from 'web-design-system/astro/product/ChatThread.astro'
import screenshot from '../assets/app.png'

import { agentThread, codingColumns, repeatRows, taskRows } from '../../data/landing'

const guides = [
  {
    heading: 'User guide',
    tone: 'accent' as const,
    badge: 'Using the app',
    body: 'Install it, get your tasks in, and set up the parts that need credentials.',
    href: '/docs',
    cta: 'Open the user guide',
    links: [
      { label: 'Install and run', href: '/docs/install' },
      { label: 'Tasks, tags, and projects', href: '/docs/tasks' },
      { label: 'Repeat and scheduling', href: '/docs/repeats' },
      { label: 'Configuration', href: '/docs/configuration' },
    ],
  },
  {
    heading: 'Contributor guide',
    tone: 'success' as const,
    badge: 'Working on it',
    body: 'How the workspace is put together, how to run it, and what a change has to pass.',
    href: '/docs/contributor',
    cta: 'Open the contributor guide',
    links: [
      { label: 'Development setup', href: '/docs/contributor/development' },
      { label: 'Architecture', href: '/docs/contributor/architecture' },
      { label: 'Integrations', href: '/docs/contributor/integrations' },
      { label: 'Contributing', href: '/docs/contributor/contributing' },
    ],
  },
]

const linkStyle = css({
  display: 'inline-flex',
  alignItems: 'center',
  h: '10',
  px: '5',
  borderRadius: 'sm',
  fontSize: 'md',
  fontWeight: 'medium',
  _focusVisible: { outline: 'none', boxShadow: 'focus' },
})

const ctaSecondary = css({
  borderWidth: 'hairline',
  borderStyle: 'solid',
  borderColor: 'border',
  color: 'fg.default',
  _hover: { bg: 'surface.hover' },
})
---

<Base
  title="todo-lofi"
  suffix="a local-first task manager"
  description="todo-lofi is a local-first task manager for macOS and Linux, built on GPUI. Nested tags and projects, repeating tasks, an embedded AI agent, and Todoist sync when you want it."
>
  <SiteHeader />

  <main id="content">
    <Hero
      title="Your tasks, on your machine"
      subtitle="todo-lofi keeps a local database, renders it with the same GPU-accelerated framework as Zed, and stays useful with no network at all. The agent pane, the workflows, and the sync are all opt-in."
      primaryCta={{ label: 'Install and run', href: '/docs/install' }}
      secondaryCta={{ label: 'Read the docs', href: '/docs' }}
    >
      <AnnouncementPill slot="pill" label="Documentation for users and contributors" href="/docs" />

      <div class={css({ maxW: '980px', mx: 'auto', px: { base: '5', md: '8' } })}>
        <img
          src={screenshot.src}
          width={screenshot.width}
          height={screenshot.height}
          alt="The todo-lofi desktop app: a task list on the left, task details in the middle, and the agent pane on the right."
          class={css({
            w: 'full',
            h: 'auto',
            borderRadius: 'lg',
            borderWidth: 'hairline',
            borderStyle: 'solid',
            borderColor: 'border',
            bg: 'surface.subtle',
          })}
        />
      </div>
    </Hero>

    <LogoCloud title="Built with" logos={['GPUI', 'Rust', 'SQLite', 'MCP', 'Astro', 'Panda CSS']} />

    <StatsBand
      value="Local first"
      label="Tasks, repeats, and workflows live in a SQLite file you own. Network features — Todoist, GitHub, model providers — each bring their own credentials and never gate the core loop."
      linkLabel="How the storage layer works"
      linkHref="/docs/contributor/architecture"
    />

    <div class={css({ mt: { base: '8', md: '12' } })}>
      <SectionHeading
        eyebrow="What it does"
        title="Work that has a shape, kept in one place"
        description="Four things the app does beyond a list of checkboxes. Each one has a page in the user guide."
      />
    </div>

    <FeatureSection
      eyebrow="Tasklist"
      title="Nested tags, projects, and areas"
      description="Tasks, tags, and projects are ordinary rows you can move, nest, and filter. A task carries a deadline, importance and urgency, subtasks, and blocking links that the list resolves into what you can actually do next."
      href="/docs/tasks"
      linkLabel="Read about the task list"
    >
      <div class={css({ display: 'flex', flexDirection: 'column', gap: '2', p: '4' })}>
        {taskRows.map((issue) => <IssueRow issue={issue} />)}
      </div>
    </FeatureSection>

    <FeatureSection
      eyebrow="Repeat and scheduling"
      title="Repeats you configure, not syntax you memorise"
      description="Recurring tasks are set up in a picker — how often, which weekdays or month day, and what time the occurrence becomes doable. That last part matters, because a task that is not due yet stays out of the way until it is."
      href="/docs/repeats"
      linkLabel="Read about repeats"
      reverse
    >
      <Timeline months={['Mon', 'Tue', 'Wed', 'Thu', 'Fri']} rows={repeatRows} />
    </FeatureSection>

    <FeatureSection
      eyebrow="AI agent"
      title="An agent that works in your lists"
      description="The agent pane is docked next to the tasks, not in a separate window. It can set up repeats, add and reshape tasks, and drive a workflow — and you can watch the tools it calls and the files it touches."
      href="/docs/agent"
      linkLabel="Read about the agent"
    >
      <ChatThread messages={agentThread} />
    </FeatureSection>

    <FeatureSection
      eyebrow="Coding workflow"
      title="Coding work moves through real stages"
      description="A task can carry a workflow whose stages have their own state — interview, spec, implement, review, merge. The agent does the work inside a stage; you decide when the stage is finished."
      href="/docs/workflows"
      linkLabel="Read about workflows"
      reverse
    >
      <KanbanBoard columns={codingColumns} />
    </FeatureSection>

    <section class={css({ py: { base: '12', md: '20' } })}>
      <div class={css({ w: '100%', maxW: '1200px', mx: 'auto', px: { base: '5', md: '8' } })}>
        <SectionHeading
          eyebrow="Documentation"
          title="Two guides, one for each job"
          description="Everything under /docs. Start with the one that matches what you are here to do."
        />

        <div
          class={css({
            display: 'grid',
            gridTemplateColumns: { base: '1fr', md: 'repeat(2, minmax(0, 1fr))' },
            gap: '4',
            mt: '10',
          })}
        >
          {
            guides.map((guide) => (
              <div
                class={css({
                  display: 'flex',
                  flexDirection: 'column',
                  gap: '4',
                  p: '6',
                  borderRadius: 'lg',
                  borderWidth: 'hairline',
                  borderStyle: 'solid',
                  borderColor: 'border',
                  bg: 'surface.subtle',
                })}
              >
                <div class={css({ display: 'flex', alignItems: 'center', gap: '3', flexWrap: 'wrap' })}>
                  <span class={css({ fontSize: 'xl', fontWeight: 'semibold', color: 'fg.default' })}>
                    {guide.heading}
                  </span>
                  <Badge tone={guide.tone} variant="subtle">{guide.badge}</Badge>
                </div>
                <p class={css({ fontSize: 'sm', color: 'fg.muted', lineHeight: 'relaxed', m: '0' })}>
                  {guide.body}
                </p>
                <ul
                  class={css({
                    listStyle: 'none',
                    m: '0',
                    p: '0',
                    display: 'flex',
                    flexWrap: 'wrap',
                    gap: '2',
                  })}
                >
                  {
                    guide.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class={css({
                            display: 'inline-flex',
                            alignItems: 'center',
                            h: '8',
                            px: '3',
                            borderRadius: 'full',
                            borderWidth: 'hairline',
                            borderStyle: 'solid',
                            borderColor: 'border',
                            bg: 'canvas',
                            fontSize: 'sm',
                            color: 'fg.muted',
                            _hover: { color: 'fg.default', borderColor: 'border.strong' },
                            _focusVisible: { outline: 'none', boxShadow: 'focus' },
                          })}
                        >
                          {link.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <div class={css({ mt: 'auto' })}>
                  <a href={guide.href} class={`${linkStyle} ${ctaSecondary}`}>{guide.cta}</a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <CTASection
      title="Start with the guide that fits"
      primaryCta={{ label: 'Install and run', href: '/docs/install' }}
      secondaryCta={{ label: 'Read the user guide', href: '/docs' }}
    />
  </main>

  <DocsFooter />
</Base>
