---
import { css } from "styled-system/css";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import DocsFooter from "../components/DocsFooter.astro";
import { Badge } from "web-design-system/components";
import Hero from "web-design-system/astro/marketing/Hero.astro";
import StatsBand from "web-design-system/astro/marketing/StatsBand.astro";
import SectionHeading from "web-design-system/astro/marketing/SectionHeading.astro";
import FeatureSection from "web-design-system/astro/marketing/FeatureSection.astro";
import CTASection from "web-design-system/astro/marketing/CTASection.astro";
import IssueRow from "web-design-system/astro/product/IssueRow.astro";
import Timeline from "web-design-system/astro/product/Timeline.astro";
import ChatThread from "web-design-system/astro/product/ChatThread.astro";
import AutomationsPanel from "../components/AutomationsPanel.astro";
import screenshot from "../assets/app.png";

import { agentThread, extensionCards, integrationCards, repeatRows, taskRows } from "../../data/landing";

const container = css({ w: "100%", maxW: "1200px", mx: "auto", px: { base: "5", md: "8" } });

const grid = css({
  display: "grid",
  gridTemplateColumns: { base: "1fr", md: "repeat(2, minmax(0, 1fr))" },
  gap: "4",
});

const card = css({
  display: "flex",
  flexDirection: "column",
  gap: "3",
  p: { base: "5", md: "6" },
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border",
  bg: "surface.subtle",
});

const cardTitle = css({
  display: "flex",
  alignItems: "center",
  gap: "3",
  flexWrap: "wrap",
});

const cardHeading = css({ fontSize: "xl", fontWeight: "semibold", color: "fg.default" });

const cardBody = css({ fontSize: "sm", color: "fg.muted", lineHeight: "relaxed", m: "0" });

const cardLink = css({
  display: "inline-flex",
  alignItems: "center",
  mt: "auto",
  pt: "1",
  fontSize: "sm",
  fontWeight: "medium",
  color: "accent.text",
  _hover: { color: "accent.hover" },
  _focusVisible: { outline: "none", boxShadow: "focus" },
});

const panel = css({
  p: "4",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border",
  bg: "surface.subtle",
});

const band = css({
  display: "flex",
  flexDirection: { base: "column", md: "row" },
  alignItems: { base: "flex-start", md: "center" },
  justifyContent: "space-between",
  gap: "5",
  p: { base: "6", md: "8" },
  borderRadius: "xl",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border",
  bg: "surface.subtle",
});

const bandText = css({ display: "flex", flexDirection: "column", gap: "1" });

const bandLink = css({
  display: "inline-flex",
  alignItems: "center",
  h: "10",
  px: "5",
  borderRadius: "sm",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border",
  fontSize: "md",
  color: "fg.default",
  whiteSpace: "nowrap",
  _hover: { bg: "surface.hover" },
  _focusVisible: { outline: "none", boxShadow: "focus" },
});

const inlineLink = css({
  color: "fg.default",
  textDecoration: "underline",
  textUnderlineOffset: "2px",
  _hover: { color: "accent.text" },
  _focusVisible: { outline: "none", boxShadow: "focus" },
});
---

<Base
  title="todo-lofi"
  suffix="a local-first task manager"
  description="todo-lofi is a local-first task manager for macOS, Linux, and Windows: your personal and work tasks in one list, an agent that can work them, repeats and priorities that keep the list honest, and two-way sync when you want it."
>
  <SiteHeader />

  <main id="content">
    <Hero
      title="An assistant for all your tasks"
      subtitle="Work and personal tasks live in one list you own, with an assistant beside them. It helps you explore a task and chunk it into actionable sub-tasks, set up repeats, and take a task through a whole staged workflow — while you watch the tools it calls and decide when the work is done."
      primaryCta={{ label: "Download", href: "/downloads" }}
      secondaryCta={{ label: "Read the docs", href: "/docs" }}
    >
      <div class={css({ maxW: "980px", mx: "auto", px: { base: "5", md: "8" } })}>
        <img
          src={screenshot.src}
          width={screenshot.width}
          height={screenshot.height}
          alt="The todo-lofi desktop app: a task list on the left, task details in the middle, and the agent pane on the right."
          class={css({
            w: "full",
            h: "auto",
            borderRadius: "lg",
            borderWidth: "hairline",
            borderStyle: "solid",
            borderColor: "border",
            bg: "surface.subtle",
          })}
        />
      </div>
    </Hero>

    <section class={css({ pb: { base: "4", md: "8" } })}>
      <div class={container}>
        <div
          class={css({
            display: "grid",
            gridTemplateColumns: { base: "1fr", md: "repeat(3, minmax(0, 1fr))" },
            gap: "4",
          })}
        >
          <div class={card}>
            <h2 class={css({ fontSize: "lg", fontWeight: "semibold", color: "fg.default", m: "0" })}>Work and personal in the same list</h2>
            <p class={cardBody}>The release review sits next to feeding the dog. One list you own, not a team tool with your errands as guests.</p>
          </div>
          <div class={card}>
            <h2 class={css({ fontSize: "lg", fontWeight: "semibold", color: "fg.default", m: "0" })}>Priorities surfaced for you</h2>
            <p class={cardBody}>Importance, urgency, and deadline pressure sort the list, so the next thing to do is already at the top.</p>
          </div>
          <div class={card}>
            <h2 class={css({ fontSize: "lg", fontWeight: "semibold", color: "fg.default", m: "0" })}>An agent to manage your lists</h2>
            <p class={cardBody}>Explore a task, chunk it into actionable sub-tasks, and drive it through its workflow — with you deciding when it is done.</p>
          </div>
        </div>
      </div>
    </section>

    <FeatureSection
      eyebrow="One list"
      title="Your whole life, not just your job"
      description="Feed the dog and review the release pull request from the same list. Most task apps are built for a team and expect your personal errands to live somewhere else; todo-lofi is centred on you, so the work that syncs in from Todoist or GitHub sits next to the tasks nobody else needs to see — and neither half is the guest."
      href="/docs/tasks"
      linkLabel="Read about the task list"
    >
      <div class={css({ display: "flex", flexDirection: "column", gap: "2", p: "4" })}>
        {taskRows.map((issue) => (
          <IssueRow issue={issue} />
        ))}
      </div>
    </FeatureSection>

    <StatsBand
      value="Offline"
      label="Your tasks live in a database file on your machine rather than on somebody's server. There is no account to create and no telemetry, and the list works with the network unplugged — sync and the agent are things you switch on when you want them."
      linkLabel="How sync stays optional"
      linkHref="/docs/sync#offline"
    />

    <FeatureSection
      eyebrow="The agent"
      title="A pane beside your list, not another chat window"
      description="The agent works in the lists you already have: it adds and edits tasks, sets up a repeat, and drives a task through its workflow stages. Every tool it calls and every file it touches is visible while it works, and nothing runs until you point it at a provider and give it a key."
      href="/docs/agent"
      linkLabel="Read about the agent"
      reverse
    >
      <ChatThread messages={agentThread} />
    </FeatureSection>

    <section class={css({ py: { base: "12", md: "20" } })}>
      <div class={container}>
        <SectionHeading
          eyebrow="Extensions"
          title="Apps that fit your workflows"
          description="Beyond the list itself, todo-lofi ships apps that own a slice of your work. They are ordinary tasks underneath — the value is the vocabulary and the defaults they bring, not a private store that holds your data hostage."
          align="left"
        />

        <div
          class={css({
            mt: { base: "8", md: "12" },
            display: "grid",
            gridTemplateColumns: { base: "1fr", lg: "minmax(0, 1fr) minmax(0, 1.15fr)" },
            gap: "4",
            alignItems: "start",
          })}
        >
          <div class={css({ display: "flex", flexDirection: "column", gap: "4" })}>
            {extensionCards.map((entry) => (
              <div class={card}>
                <div class={cardTitle}>
                  <h3 class={cardHeading}>{entry.name}</h3>
                  <Badge tone={entry.tone} variant="subtle">
                    {entry.badge}
                  </Badge>
                </div>
                <p class={cardBody}>{entry.body}</p>
                <a href={entry.href} class={cardLink}>
                  {entry.linkLabel} →
                </a>
              </div>
            ))}
          </div>

          <div class={css({ display: "flex", flexDirection: "column", gap: "3" })}>
            <div class={panel}>
              <AutomationsPanel />
            </div>
            <p class={css({ m: "0", fontSize: "xs", color: "fg.subtle" })}>
              The automations pane: a recipe, the runs under it with the phase each one has reached, and the branch cleanup a coding run leaves behind.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class={css({ py: { base: "12", md: "20" } })}>
      <div class={container}>
        <SectionHeading
          eyebrow="Everyday"
          title="What to do next, decided for you"
          description="A long list is only useful if it orders itself. todo-lofi does that quietly in the background, so you can stop re-reading everything just to find the one thing that matters now."
          align="left"
        />

        <div class={`${grid} ${css({ mt: { base: "8", md: "12" } })}`}>
          <div class={card}>
            <h3 class={css({ fontSize: "lg", fontWeight: "semibold", color: "fg.default" })}>Priority that sorts itself</h3>
            <p class={cardBody}>
              Each task carries the importance and urgency you gave it, and the list folds in deadline pressure: a task with no deadline keeps the score you set, one whose deadline
              is close climbs steeply, and an overdue task keeps rising until it is handled. Subtasks, blocked-by chains, and softer ordering hints are resolved into what you can
              actually start on.
            </p>
            <a href="/docs/tasks#priority" class={cardLink}>
              Read about priority and ordering →
            </a>
          </div>

          <div class={card}>
            <h3 class={css({ fontSize: "lg", fontWeight: "semibold", color: "fg.default" })}>Repeats you configure, not syntax you memorise</h3>
            <p class={cardBody}>
              Recurring tasks are set up in a picker — how often, which weekdays or month day, and what time the occurrence becomes doable. That last part matters: a task that is
              not due yet stays out of the way until it is, instead of sitting at the top of the list for days.
            </p>
            <a href="/docs/repeats" class={cardLink}>
              Read about repeats →
            </a>
          </div>
        </div>

        <div class={`${panel} ${css({ mt: "4" })}`}>
          <Timeline months={["Mon", "Tue", "Wed", "Thu", "Fri"]} rows={repeatRows} />
        </div>
      </div>
    </section>

    <section class={css({ py: { base: "12", md: "20" } })}>
      <div class={container}>
        <SectionHeading
          eyebrow="Integrations"
          title="Sync with tools you already use"
          description="Can't choose what tools your company uses ? Sync work tasks with other tools, yet keep your personal tasks in the same list"
          align="left"
        />

        <div class={`${grid} ${css({ mt: { base: "8", md: "12" } })}`}>
          {integrationCards.map((entry) => (
            <div class={card}>
              <div class={cardTitle}>
                <h3 class={cardHeading}>{entry.name}</h3>
                <Badge tone={entry.tone} variant="subtle">
                  {entry.badge}
                </Badge>
              </div>
              <p class={cardBody}>{entry.body}</p>
              <a href={entry.href} class={cardLink}>
                {entry.linkLabel} →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class={css({ py: { base: "12", md: "20" } })}>
      <div class={container}>
        <div class={band}>
          <div class={bandText}>
            <span class={css({ fontSize: "xl", fontWeight: "semibold", color: "fg.default" })}>What is coming next</span>
            <p class={css({ m: "0", fontSize: "sm", color: "fg.muted", maxW: "640px" })}>
              GitHub sync and the coding workflow are in preview, and a few mini-apps — message follow-ups, birthdays, job applications — are still only specified. The roadmap says
              where each one stands, including the ideas that have no promise behind them.
            </p>
          </div>
          <a href="/roadmap" class={bandLink}>
            See the roadmap
          </a>
        </div>

        <p class={css({ m: "0", mt: "8", fontSize: "sm", color: "fg.muted" })}>
          Every feature here has a page: installation, the task list, repeats, the agent, workflows, sync, and configuration all live in{" "}
          <a href="/docs" class={inlineLink}>
            the user guide
          </a>
          .
        </p>
      </div>
    </section>

    <CTASection title="Get it on your machine" primaryCta={{ label: "Download", href: "/downloads" }} secondaryCta={{ label: "Read the docs", href: "/docs" }} />
  </main>

  <DocsFooter />
</Base>
