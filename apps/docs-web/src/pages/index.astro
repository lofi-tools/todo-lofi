---
import { css } from "styled-system/css";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/blocks/SiteHeader.astro";
import DocsFooter from "../components/blocks/DocsFooter.astro";
import Hero from "web-design-system/astro/marketing/Hero.astro";
import CTASection from "web-design-system/astro/marketing/CTASection.astro";
import HomepageSection from "../components/sections/HomepageSection.astro";
import ReasonsSection from "../components/sections/ReasonsSection.astro";
import OneListSection from "../components/sections/OneListSection.astro";
import OfflineSection from "../components/sections/OfflineSection.astro";
import AgentSection from "../components/sections/AgentSection.astro";
import ExtensionsSection from "../components/sections/ExtensionsSection.astro";
import EverydaySection from "../components/sections/EverydaySection.astro";
import IntegrationsSection from "../components/sections/IntegrationsSection.astro";
import RoadmapSection from "../components/sections/RoadmapSection.astro";
import { blueprintContent, blueprintGrid, blueprintRules } from "../components/sections/homeStyles";
import screenshot from "../assets/app.png";
---


<Base
  title="todo-lofi"
  suffix="a local-first task manager"
  description="todo-lofi is a local-first task manager for macOS, Linux, and Windows: your personal and work tasks in one list, an agent that can work them, repeats and priorities that keep the list honest, and two-way sync when you want it."
>
  <SiteHeader blueprint />

  <main id="content" class={blueprintGrid}>
    <div class={blueprintContent}>
      <Hero
        title="An assistant for all your tasks"
        subtitle="Work and personal tasks live in one list you own, with an assistant beside them. It helps you explore a task and chunk it into actionable sub-tasks, set up repeats, and take a task through a whole staged workflow — while you watch the tools it calls and decide when the work is done."
        primaryCta={{ label: "Download", href: "/downloads" }}
        secondaryCta={{ label: "Read the docs", href: "/docs" }}
      >
        <div class={css({ maxW: "980px", mx: "auto", px: { base: "5", md: "8" } })}>
          <img
            src={screenshot.src}
            width={screenshot.width}
            height={screenshot.height}
            alt="The todo-lofi desktop app: a task list on the left, task details in the middle, and the agent pane on the right."
            class={css({
              w: "full",
              h: "auto",
              borderRadius: "lg",
              borderWidth: "hairline",
              borderStyle: "solid",
              borderColor: "border",
              bg: "surface.subtle",
            })}
          />
        </div>
      </Hero>
    </div>

    <ReasonsSection />
    <OneListSection />
    <OfflineSection />
    <AgentSection />
    <ExtensionsSection />
    <EverydaySection />
    <IntegrationsSection />
    <RoadmapSection />

    <HomepageSection bare index={9} label="get started">
      <CTASection title="Get it on your machine" primaryCta={{ label: "Download", href: "/downloads" }} secondaryCta={{ label: "Read the docs", href: "/docs" }} />
    </HomepageSection>
  </main>

  <!-- Vertical blueprint rules: one fixed overlay so the lines run unbroken
       from the header to the footer. -->
  <div class={blueprintRules} aria-hidden="true"></div>

  <DocsFooter blueprint />
</Base>
