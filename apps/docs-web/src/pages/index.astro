---
import { css } from "styled-system/css";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/blocks/SiteHeader.astro";
import DocsFooter from "../components/blocks/DocsFooter.astro";
import Hero from "web-design-system/astro/marketing/Hero.astro";
import CTASection from "web-design-system/astro/marketing/CTASection.astro";
import HomepageSection from "../components/sections/HomepageSection.astro";
import ReasonsSection from "../components/sections/ReasonsSection.astro";
import OneListSection from "../components/sections/OneListSection.astro";
import AgentSection from "../components/sections/AgentSection.astro";
import ExtensionsSection from "../components/sections/ExtensionsSection.astro";
import ManagedForYouSection from "../components/sections/ManagedForYouSection.astro";
import EverydaySection from "../components/sections/EverydaySection.astro";
import IntegrationsSection from "../components/sections/IntegrationsSection.astro";
import RoadmapSection from "../components/sections/RoadmapSection.astro";
import CraftSection from "../components/sections/CraftSection.astro";
import DownloadButton from "../components/blocks/DownloadButton.astro";
import { blueprintContent, blueprintGrid, blueprintRules } from "../components/sections/homeStyles";
import screenshot from "../assets/app.png";
---


<Base
  title="Taskstream"
  suffix="a local-first task manager"
  description="Taskstream is a local-first task manager for macOS, Linux, and Windows: personal and work tasks in one list, an agent that can work them, repeats and priorities, and two-way sync when you want it."
>
  <SiteHeader blueprint />

  <main id="content" class={blueprintGrid}>
    <div class={blueprintContent}>
      <Hero
        title="An assistant for all your tasks"
        subtitle="Work and personal tasks in one list you own, with an assistant beside them. It breaks tasks into sub-tasks, sets up repeats, and runs a staged workflow — you watch every step and decide when work is done."
        secondaryCta={{ label: "Read the docs", href: "/docs" }}
      >
        <DownloadButton slot="primary" />
        <div class={css({ w: "full", px: { base: "5", md: "8" } })}>
          <div class={css({ position: "relative" })}>
            <img
              src={screenshot.src}
              width={screenshot.width}
              height={screenshot.height}
              alt="The Taskstream desktop app: a task list on the left, task details in the middle, and the agent pane on the right."
              class={css({ w: "full", h: "auto" })}
            />
            <!-- Fade the screenshot into the page at its bottom edge. -->
            <div
              aria-hidden="true"
              class={css({
                position: "absolute",
                left: "0",
                right: "0",
                bottom: "0",
                h: "40%",
                backgroundImage:
                  "linear-gradient(to bottom, transparent, var(--colors-canvas))",
                pointerEvents: "none",
              })}
            />
          </div>
        </div>
      </Hero>
    </div>

    <ReasonsSection />
    <OneListSection />
    <AgentSection />
    <ExtensionsSection />
    <ManagedForYouSection />
    <EverydaySection />
    <IntegrationsSection />
    <RoadmapSection />
    <CraftSection />

    <HomepageSection bare index={10} label="get it now">
      <CTASection title="Get it now" secondaryCta={{ label: "All downloads", href: "/downloads" }}>
        <DownloadButton slot="primary" />
      </CTASection>
    </HomepageSection>
  </main>

  <!-- Vertical blueprint rules: one fixed overlay so the lines run unbroken
       from the header to the footer. -->
  <div class={blueprintRules} aria-hidden="true"></div>

  <DocsFooter blueprint />
</Base>
