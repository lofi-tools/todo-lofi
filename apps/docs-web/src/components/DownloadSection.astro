---
import { css } from 'styled-system/css'
import SectionHeading from 'web-design-system/astro/marketing/SectionHeading.astro'
import { FORMATS, PLATFORMS, RELEASES_URL } from '../../data/downloads'

const chip = css({
  display: 'inline-flex',
  alignItems: 'center',
  gap: '2',
  h: '9',
  px: '4',
  borderRadius: 'full',
  borderWidth: 'hairline',
  borderStyle: 'solid',
  borderColor: 'border',
  bg: 'canvas',
  fontSize: 'sm',
  color: 'fg.muted',
  cursor: 'pointer',
  transitionProperty: 'color, border-color, background-color',
  transitionDuration: 'fast',
  _hover: { color: 'fg.default', borderColor: 'border.strong' },
  _focusVisible: { outline: 'none', boxShadow: 'focus' },
  '&[data-selected]': { color: 'fg.default', borderColor: 'accent', bg: 'accent.subtle' },
})

const detectedBadge = css({
  fontSize: '2xs',
  textTransform: 'uppercase',
  letterSpacing: 'wider',
  color: 'accent.text',
})

const primary = css({
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  h: '11',
  px: '6',
  borderRadius: 'sm',
  bg: 'accent',
  color: 'fg.onAccent',
  fontSize: 'md',
  fontWeight: 'medium',
  _hover: { bg: 'accent.hover' },
  _focusVisible: { outline: 'none', boxShadow: 'focus' },
})

const inlineLink = css({
  color: 'fg.muted',
  textDecoration: 'underline',
  textUnderlineOffset: '2px',
  _hover: { color: 'fg.default' },
  _focusVisible: { outline: 'none', boxShadow: 'focus' },
})

const formatLink = css({
  display: 'inline-flex',
  alignItems: 'center',
  h: '8',
  px: '3',
  borderRadius: 'sm',
  borderWidth: 'hairline',
  borderStyle: 'solid',
  borderColor: 'border',
  bg: 'canvas',
  fontFamily: 'mono',
  fontSize: 'xs',
  color: 'fg.muted',
  _hover: { color: 'fg.default', borderColor: 'border.strong' },
  _focusVisible: { outline: 'none', boxShadow: 'focus' },
})

const panel = css({
  p: { base: '5', md: '6' },
  borderRadius: 'lg',
  borderWidth: 'hairline',
  borderStyle: 'solid',
  borderColor: 'border',
  bg: 'surface.subtle',
})

const panelStack = css({ display: 'flex', flexDirection: 'column', gap: '3' })
---

<section id="download" class={css({ py: { base: '12', md: '20' } })}>
  <div class={css({ w: '100%', maxW: '1200px', mx: 'auto', px: { base: '5', md: '8' } })}>
    <SectionHeading
      eyebrow="Download"
      title="Get todo-lofi for your machine"
      description="Prebuilt bundles for macOS, Linux, and Windows. The button starts on the platform you are reading this from; switch it if you need another one."
      align="left"
    />

    <div
      class={css({
        mt: { base: '8', md: '12' },
        display: 'grid',
        gridTemplateColumns: { base: '1fr', lg: 'minmax(0, 1.15fr) minmax(0, 1fr)' },
        gap: '4',
        alignItems: 'start',
      })}
    >
      <div class={css({ display: 'flex', flexDirection: 'column', gap: '4' })}>
        <div role="group" aria-label="Choose a platform" class={css({ display: 'flex', flexWrap: 'wrap', gap: '2' })}>
          {
            PLATFORMS.map((platform) => (
              <button
                type="button"
                data-download-option={platform.id}
                aria-pressed="false"
                class={chip}
              >
                {platform.label}
                <span data-download-detected={platform.id} hidden class={detectedBadge}>
                  this machine
                </span>
              </button>
            ))
          }
        </div>

        <a
          data-download
          data-platform="auto"
          data-download-primary
          href={RELEASES_URL}
          class={primary}
        >
          <span data-download-primary-label>Browse all downloads</span>
        </a>

        <p class={css({ m: '0', fontSize: 'sm', color: 'fg.muted' })}>
          <span data-download-version>the latest release</span>
          {' · '}
          <a href={RELEASES_URL} class={inlineLink}>all versions</a>
        </p>

        {
          PLATFORMS.map((platform) => (
            <div
              data-download-formats={platform.id}
              hidden={platform.id !== 'macos'}
              class={css({ display: 'flex', flexWrap: 'wrap', gap: '2' })}
            >
              <span class={css({ fontSize: 'xs', color: 'fg.subtle', alignSelf: 'center' })}>
                {platform.label} builds
              </span>
              {FORMATS[platform.id].map((format) => (
                <a
                  data-download
                  data-platform={platform.id}
                  data-format={format.id}
                  href={RELEASES_URL}
                  title={format.hint}
                  class={formatLink}
                >
                  {format.label}
                </a>
              ))}
            </div>
          ))
        }
      </div>

      <div class={`${panel} ${panelStack}`}>
        <h3 class={css({ fontSize: 'md', fontWeight: 'semibold', color: 'fg.default', m: '0' })}>
          Before you run it
        </h3>
        <ul class={css({ m: '0', pl: '5', display: 'flex', flexDirection: 'column', gap: '2' })}>
          {
            PLATFORMS.map((platform) => (
              <li class={css({ fontSize: 'sm', color: 'fg.muted', lineHeight: 'relaxed' })}>
                <span class={css({ fontWeight: 'medium', color: 'fg.default' })}>{platform.label}</span>
                {' — '}
                {platform.requirement}. The macOS bundle is unsigned, so the first launch needs
                {platform.id === 'macos' ? ' the Gatekeeper confirmation' : ' no extra steps'}.
              </li>
            ))
          }
        </ul>
        <p class={css({ m: '0', fontSize: 'sm', color: 'fg.muted' })}>
          <a href="/docs/install" class={inlineLink}>Full install instructions →</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initDownloads } from '../../data/downloads'
  void initDownloads()
</script>
