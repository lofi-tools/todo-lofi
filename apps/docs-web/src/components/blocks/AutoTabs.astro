---
import { css } from "styled-system/css";
import { stageBackdrops, stageNote } from "../illustrations/styles";
import {
  glyph,
  itemHeading,
  tab,
  tabContent,
  tabDescription,
  tabIndex,
  tabList,
  tabPanel,
  tabProgressBar,
  tabProgressTrack,
  tabsColumn,
  tabsLayout,
  tabSubtitle,
  tabTitle,
} from "../sections/homeStyles";

interface TabItem {
  title: string;
  subtitle: string;
  description: string;
  /** Glyph shown in the panel when the item has no illustration. */
  Icon?: any;
  /** Panel content; replaces the icon-and-title panel when present. */
  Illustration?: any;
  /**
   * One-line note set at the top of the panel, before the illustration, so the
   * mock window itself stays a pure screen replica.
   */
  note?: string;
}

interface Props {
  /** Accessible name for the tab list, and the base for the panel ids. */
  label: string;
  items: TabItem[];
}

const { label, items } = Astro.props;

const idBase = label.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

// The right pane is a single backdrop shared by every tab: one gradient
// wash for the whole pane instead of a stage per illustration. It stretches
// to the row height and holds a minimum height of its own, so the backdrop
// stays full-height no matter which illustration is showing or how short it
// is. Text-only panels keep the card chrome inside it.
const pane = `${stageBackdrops.indigo} ${css({
  alignSelf: "stretch",
  display: "flex",
  flexDirection: "column",
  borderRadius: "lg",
  px: { base: "3", md: "6" },
  py: { base: "6", md: "8" },
  minH: { base: "24rem", md: "29rem" },
})}`;

// Panels holding an illustration drop the card chrome and fill the pane. The
// illustration stays fully opaque on top of the shared backdrop: no fade mask,
// so the backdrop never bleeds through the content — the padded frame is what
// marks it as illustration rather than a content card.
const barePanel = css({
  display: "flex",
  flexDirection: "column",
  flex: "1",
  gap: "4",
  "&[hidden]": { display: "none" },
});

---

<div class={tabsLayout} data-auto-tabs>
  <div class={tabsColumn}>
    <div class={tabList} role="tablist" aria-orientation="vertical" aria-label={label}>
      {
        items.map(({ title, subtitle, description }, index) => (
          <button
            type="button"
            role="tab"
            id={`${idBase}-tab-${index}`}
            aria-controls={`${idBase}-panel-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-active={index === 0 ? "" : undefined}
            class={tab}
          >
            <span class={tabContent}>
              <span class={tabIndex}>{String(index + 1).padStart(2, "0")}</span>
              <span class={tabTitle} data-tab-title>
                {title}
              </span>
              <span class={tabSubtitle}>{subtitle}</span>
              <span class={tabDescription} data-tab-description>
                {description}
              </span>
            </span>
            <span class={tabProgressTrack} data-tab-progress-track aria-hidden="true">
              <span class={tabProgressBar} data-tab-progress />
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class={pane}>
    {
      items.map(({ title, Icon, Illustration, note }, index) => (
        <div
          role="tabpanel"
          id={`${idBase}-panel-${index}`}
          aria-labelledby={`${idBase}-tab-${index}`}
          tabindex="0"
          hidden={index !== 0}
          class={Illustration ? barePanel : tabPanel}
        >
          {Illustration ? (
            <>
              {note && <p class={stageNote}>{note}</p>}
              <Illustration />
            </>
          ) : (
            <>
              <span class={glyph}>{Icon && <Icon size={22} />}</span>
              <h3 class={itemHeading}>{title}</h3>
            </>
          )}
        </div>
      ))
    }
  </div>
</div>

<script>
  import { startAutoSwitch } from "./autoSwitch";

  const DURATION = 6000;

  for (const root of document.querySelectorAll<HTMLElement>("[data-auto-tabs]")) {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
    let animation: Animation | undefined;

    // The bar lives inside the active tab, so it runs under the tab it times.
    const restartProgress = (index: number) => {
      animation?.cancel();
      animation = undefined;
      const progress = tabs[index]?.querySelector<HTMLElement>("[data-tab-progress]");
      if (!progress) return;
      animation = progress.animate([{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], {
        duration: DURATION,
        easing: "linear",
      });
      // The engine decides whether the clock is running; start paused.
      animation.pause();
    };

    startAutoSwitch(root, {
      duration: DURATION,
      onSelect: restartProgress,
      onToggle: (running) => (running ? animation?.play() : animation?.pause()),
    });
  }
</script>
