---
import CodeBlock from "web-design-system/astro/product/CodeBlock.astro";
import { FORMATS, RELEASES_URL, archToken, primaryArch } from "../../../data/downloads";
import type { FormatId, PlatformId } from "../../../data/downloads";

interface Props {
  platform: PlatformId;
  /**
   * Architectures to write into the file names. Providing more than one
   * renders a copy of each architecture-specific block, tagged so the caller
   * can filter between them; omitted, the blocks are written once for the
   * platform's primary architecture.
   */
  arches?: string[];
}

const { platform, arches } = Astro.props;

const archIds = arches?.length ? arches : [primaryArch(platform).id];

/** The steps that differ by architecture, keyed by format. */
const linuxScripts: Partial<Record<FormatId, string>> = {
  appimage: `# Make it executable and run it; there is no install step.
chmod +x taskstream-<version>-linux-<arch>.AppImage
./taskstream-<version>-linux-<arch>.AppImage`,
  deb: `# Installs into /usr; the package carries its own libraries.
sudo apt install ./taskstream-<version>-linux-<arch>.deb
taskstream`,
  tarball: `tar -xzf taskstream-<version>-linux-<arch>.tar.gz
./taskstream/usr/bin/taskstream`,
};
---

<ul>
  {
    FORMATS[platform].map((format) => (
      <li data-install-format={format.id}>
        <a data-download data-platform={platform} data-format={format.id} href={RELEASES_URL}>
          <code data-download-name>{format.label}</code>
        </a>
        {" — "}
        {format.hint}
      </li>
    ))
  }
</ul>

{
  platform === "macos" && (
    <ol>
      <li>Download the <code>.dmg</code> and open it, or download the <code>.zip</code> and unzip it.</li>
      <li>Drag <code>taskstream.app</code> into your <code>/Applications</code> folder.</li>
      <li>
        Open the app once. Gatekeeper stops an unsigned build the first time: go to
        <strong>System Settings → Privacy &amp; Security</strong>, scroll to the security notice, and
        choose <strong>Open Anyway</strong>. Right-clicking the app in the Finder and choosing
        <strong>Open</strong> does the same thing.
      </li>
    </ol>
  )
}

{
  platform === "linux" && (
    <>
      <p>
        The AppImage runs without installing anything. The other two fit the usual layouts: the{" "}
        <code>.deb</code> installs under <code>/usr</code>, and the tarball unpacks anywhere.
      </p>
      {
        FORMATS.linux.map((format) =>
          archIds.map((arch) => (
            <div
              data-install-format={format.id}
              data-install-arch={arch}
              hidden={arch !== primaryArch("linux").id}
            >
              <CodeBlock
                filename="terminal"
                code={(linuxScripts[format.id] ?? "").replaceAll("<arch>", archToken("linux", arch))}
                showLineNumbers={false}
              />
            </div>
          )),
        )
      }
    </>
  )
}

{
  platform === "windows" && (
    <ol>
      <li>Download the <code>.zip</code> and extract it.</li>
      <li>
        Run <code>taskstream.exe</code>. SmartScreen may warn about an unsigned build the first time:
        choose <strong>More info</strong>, then <strong>Run anyway</strong>. The archive is
        self-contained — nothing to install and nothing to clean up.
      </li>
    </ol>
  )
}
