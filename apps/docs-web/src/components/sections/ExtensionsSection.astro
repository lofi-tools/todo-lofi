---
import { css } from "styled-system/css";
import HomepageSection from "./HomepageSection.astro";
import { Badge } from "web-design-system/components";
import SectionHeading from "web-design-system/astro/marketing/SectionHeading.astro";
import IllustrationCycle from "../blocks/IllustrationCycle.astro";
import BirthdayReminders from "../illustrations/BirthdayReminders.astro";
import CodingWorkflow from "../illustrations/CodingWorkflow.astro";
import JobTracking from "../illustrations/JobTracking.astro";
import TravelChecklist from "../illustrations/TravelChecklist.astro";
import WorkflowDiagram from "../illustrations/WorkflowDiagram.astro";
import IllustrationStage from "../illustrations/IllustrationStage.astro";
import { extensionCards } from "../../../data/landing";
import { cardBody, cardHeading, cardLink, cardTitle, item, subGrid } from "./homeStyles";

const [miniApps, workflows, coding] = extensionCards;

const examples = [
  {
    title: "travel",
    Illustration: TravelChecklist,
    note: "Give it a trip and it writes the list as ordinary tasks.",
  },
  {
    title: "birthdays",
    Illustration: BirthdayReminders,
    note: "A yearly reminder and a gift idea per person, kept as tasks.",
  },
  {
    title: "jobs",
    Illustration: JobTracking,
    note: "Each stage is a section, so an application moves like any task.",
  },
];

/** The sub-section's ordinal, in the same mono voice as the section markers. */
const ordinal = css({ fontFamily: "mono", fontSize: "2xs", color: "accent.text" });

/**
 * The sub-grid's items stretch to the row height, which is what keeps the
 * gutter colour from showing below a short item. That also gives `cardLink`'s
 * `mt: auto` a free space to claim, and it would spend it on pushing the link —
 * and the illustration under it — to the bottom of the cell. These sub-sections
 * stack from the top instead.
 *
 * Scoped to the item rather than added to the link: two utility classes on one
 * element tie on specificity, so it would come down to whichever rule Panda
 * happens to emit last.
 */
const stackedItem = css({ "& a": { mt: "0" } });

/** Breathing room between a block's link and its illustration. */
const illustration = css({ mt: { base: "6", md: "8" } });

/** The nested card under the workflows illustration. */
const secondary = css({
  display: "flex",
  flexDirection: "column",
  gap: "3",
  mt: { base: "8", md: "10" },
  pt: { base: "6", md: "8" },
  borderTopWidth: "hairline",
  borderTopStyle: "solid",
  borderTopColor: "border.subtle",
});

const secondaryHeading = css({ fontSize: "lg", fontWeight: "semibold", color: "fg.default", m: "0" });
---

<HomepageSection index={4} label="extensions">
  <SectionHeading
    eyebrow="Extensions"
    title="Apps that fit your workflows"
    description="Beyond the list, Taskstream ships apps that own a slice of your work. Underneath they're ordinary tasks — the value is their vocabulary and defaults, not a private store."
    align="left"
  />

  <div class={`${subGrid} ${css({ mt: { base: "8", md: "12" } })}`}>
    <div class={`${item} ${stackedItem}`}>
      <div class={cardTitle}>
        <span class={ordinal}>01</span>
        <h3 class={cardHeading}>{miniApps.name}</h3>
      </div>
      <p class={cardBody}>{miniApps.body}</p>
      <a href={miniApps.href} class={cardLink}>{miniApps.linkLabel} →</a>
      <div class={illustration}>
        <IllustrationCycle label="Mini-app examples" items={examples} />
      </div>
    </div>

    <div class={`${item} ${stackedItem}`}>
      <div class={cardTitle}>
        <span class={ordinal}>02</span>
        <h3 class={cardHeading}>{workflows.name}</h3>
      </div>
      <p class={cardBody}>{workflows.body}</p>
      <a href={workflows.href} class={cardLink}>{workflows.linkLabel} →</a>
      <div class={illustration}>
        <IllustrationStage
          fade="none"
          tone="purple"
          note="Rejection does not throw the run away — it reopens the spec, so the next round starts from the objection."
        >
          <WorkflowDiagram />
        </IllustrationStage>
      </div>

      <div class={secondary}>
        <div class={cardTitle}>
          <h4 class={secondaryHeading}>{coding.name}</h4>
          <Badge tone={coding.tone} variant="subtle">{coding.badge}</Badge>
        </div>
        <p class={cardBody}>{coding.body}</p>
        <a href={coding.href} class={cardLink}>{coding.linkLabel} →</a>
        <div class={illustration}>
          <IllustrationStage fade="none" tone="indigo">
            <CodingWorkflow />
          </IllustrationStage>
        </div>
      </div>
    </div>
  </div>
</HomepageSection>
