---
import { css } from "styled-system/css";
import HomepageSection from "./HomepageSection.astro";
import SectionHeading from "web-design-system/astro/marketing/SectionHeading.astro";
import RepeatPriority from "../illustrations/RepeatPriority.astro";
import { grid, card, cardBody, cardLink } from "./homeStyles";
---

<HomepageSection index={6} label="everyday">
      <SectionHeading
        eyebrow="Everyday"
        title="What to do next, decided for you"
        description="A long list only helps if it orders itself. Taskstream does that quietly, so you stop re-reading everything to find what matters now."
        align="left"
      />

      <div class={`${grid} ${css({ mt: { base: "8", md: "12" } })}`}>
        <div class={card}>
          <h3 class={css({ fontSize: "lg", fontWeight: "semibold", color: "fg.default" })}>Priority that sorts itself</h3>
          <p class={cardBody}>
            Each task carries the importance and urgency you set, and the list folds in deadline pressure: near deadlines climb, overdue tasks keep rising. Subtasks,
            blocked-by chains, and ordering hints resolve into what you can actually start.
          </p>
          <a href="/docs/tasks#priority" class={cardLink}>
            Read about priority and ordering →
          </a>
        </div>

        <div class={card}>
          <h3 class={css({ fontSize: "lg", fontWeight: "semibold", color: "fg.default" })}>Repeats you configure, not syntax you memorise</h3>
          <p class={cardBody}>
            Set repeats in a picker — how often, which days, and when the occurrence becomes doable. A task that isn't due yet stays out of the way until it is.
          </p>
          <a href="/docs/repeats" class={cardLink}>
            Read about repeats →
          </a>
        </div>
      </div>

      <div class={css({ mt: "4" })}>
        <RepeatPriority />
      </div>
    </HomepageSection>
