---
import { css } from "styled-system/css";
import { Filter, Layers, User, Zap } from "web-design-system/icons";
import HomepageSection from "./HomepageSection.astro";
import SectionHeading from "web-design-system/astro/marketing/SectionHeading.astro";
import AutoTabs from "../blocks/AutoTabs.astro";
import AutoSortRows from "../illustrations/AutoSortRows.astro";
import CenteredOnYou from "../illustrations/CenteredOnYou.astro";

const areas = [
  {
    Icon: User,
    Illustration: CenteredOnYou,
    title: "Centered on you",
    subtitle: "Work & personal",
    description:
      "Work and personal tasks share one list that is yours; nothing assumes a team, and no one else's workflow shapes how you organize.",
  },
  {
    Icon: Zap,
    Illustration: AutoSortRows,
    title: "Sorted for you",
    subtitle: "Auto-sort",
    description:
      "Importance, urgency, and deadline pressure order the list. There is no reminder to set — your next task floats to the top on its own.",
  },
  {
    Icon: Layers,
    title: "Tags and subtasks",
    subtitle: "Organize",
    description:
      "Tags cut across projects, and subtasks with blocked-by chains show what you can start now and what is waiting.",
  },
  {
    Icon: Filter,
    title: "Projects, areas, filters",
    subtitle: "Structure",
    description:
      "Projects hold tasks, areas hold projects, and a tag filter saves a view. The tree is yours to arrange, drag-and-drop and all.",
  },
];
---

<HomepageSection index={2} label="tasks">
  <SectionHeading
    eyebrow="Tasks"
    title="All your tasks, organized"
    description="Everything about a task lives in one place: where it sits, what it is tagged with, and what comes next."
    align="left"
  />

  <div class={css({ mt: { base: "8", md: "12" } })}>
    <AutoTabs label="Task organization" items={areas} />
  </div>
</HomepageSection>
