---
import { css } from "styled-system/css";
import HomepageSection from "./HomepageSection.astro";
import SectionHeading from "web-design-system/astro/marketing/SectionHeading.astro";
import { band, bandLink, bandText, cardBody } from "./homeStyles";

const claims = [
  {
    index: "01",
    kicker: "local-first",
    title: "Instant, because it is local",
    body: "Tasks live in a file on your machine, so there is no server round-trip between a keystroke and the list. It opens immediately and keeps working with no connection.",
  },
  {
    index: "02",
    kicker: "native",
    title: "Native and GPU-accelerated",
    body: "Written in Rust on GPUI — the GPU-accelerated UI framework behind Zed. The interface is drawn on the GPU, so scrolling and animation stay smooth even on a long list.",
  },
  {
    index: "03",
    kicker: "keyboard",
    title: "Shortcuts for nearly everything",
    body: "Move, edit, tag, and complete without reaching for the mouse, and open the command palette to reach any action by name. The full list lives in the app.",
  },
];

/**
 * Section padding. The columns carry the bottom padding on desktop, so their
 * separators run down to the closing card instead of stopping at the last line
 * of text.
 */
const sectionBox = css({
  px: { base: "5", md: "8" },
  pt: { base: "12", md: "20" },
  pb: { base: "12", md: "0" },
});

/**
 * Three hairline-separated columns, the way the rest of the homepage states a
 * feature: a mono kicker, one claim, and a paragraph of support. The negative
 * margin cancels the section padding so the block spans the section's full
 * width and the first column reaches its left edge. Column rules only stand on
 * desktop; narrow screens stack the claims with rules between.
 */
const columns = css({
  display: "grid",
  gridTemplateColumns: { base: "1fr", md: "repeat(3, minmax(0, 1fr))" },
  mt: { base: "8", md: "12" },
  mx: { base: "0", md: "-8" },
  borderTopWidth: "hairline",
  borderTopStyle: "solid",
  borderTopColor: "border.subtle",
});

const column = css({
  display: "flex",
  flexDirection: "column",
  gap: "3",
  pt: { base: "5", md: "8" },
  pb: { base: "0", md: "20" },
  px: { base: "0", md: "8" },
  borderTopWidth: { base: "hairline", md: "0" },
  borderTopStyle: "solid",
  borderTopColor: "border.subtle",
  borderLeftWidth: { base: "0", md: "hairline" },
  borderLeftStyle: "solid",
  borderLeftColor: "border.subtle",
  _first: { pt: { base: "0", md: "8" }, borderTopWidth: "0", borderLeftWidth: "0" },
});

/** The offline card closes the section; the section's own padding resumes under it. */
const offlineCard = css({ mt: { base: "8", md: "0" }, pb: { base: "0", md: "20" } });

const kicker = css({
  display: "flex",
  alignItems: "baseline",
  gap: "3",
  fontFamily: "mono",
  fontSize: "xs",
  letterSpacing: "wide",
  textTransform: "uppercase",
  color: "fg.subtle",
});

const kickerIndex = css({ color: "accent.text" });

const columnTitle = css({
  fontSize: "lg",
  fontWeight: "semibold",
  color: "fg.default",
  lineHeight: "snug",
  m: "0",
});
---

<HomepageSection bare index={9} label="craft">
  <div class={sectionBox}>
    <SectionHeading eyebrow="Performant tech" title="Crafted with care" description="A native, fast, battery-friendly desktop app" align="left" />

    <div class={columns}>
      {claims.map((claim) => (
        <div class={column}>
          <span class={kicker}>
            <span class={kickerIndex}>{claim.index}</span>
            {claim.kicker}
          </span>
          <h3 class={columnTitle}>{claim.title}</h3>
          <p class={cardBody}>{claim.body}</p>
        </div>
      ))}
    </div>

    <div class={offlineCard}>
      <div class={band}>
        <div class={bandText}>
          <span class={css({ fontSize: "xl", fontWeight: "semibold", color: "fg.default" })}>Offline by default</span>
          <p class={css({ m: "0", fontSize: "sm", color: "fg.muted", maxW: "640px" })}>
            No account, no telemetry, and no server in the loop. Sync and the agent are opt-in, and everything else keeps working without a connection.
          </p>
        </div>
        <a href="/docs/sync#offline" class={bandLink}>
          How sync stays optional
        </a>
      </div>
    </div>
  </div>
</HomepageSection>
