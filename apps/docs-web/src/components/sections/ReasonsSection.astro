---
import { Inbox, Sparkles, TrendingUp } from "web-design-system/icons";
import HomepageSection from "./HomepageSection.astro";
import { cardBody, glyph, item, itemHeading, itemSubtitle, reasonsGrid } from "./homeStyles";

const reasons = [
  {
    Icon: Inbox,
    title: "Work & personal",
    subtitle: "One list",
    body: "Your release review sits beside feeding the dog — one list you own, not a team tool.",
  },
  {
    Icon: TrendingUp,
    title: "Your next task, on top",
    subtitle: "Sorted for you",
    body: "Importance, urgency, and deadlines order the list, so the next thing to do is already at the top.",
  },
  {
    Icon: Sparkles,
    title: "An agent in your lists",
    subtitle: "Works in place",
    body: "It explores a task, breaks it into sub-tasks, and drives it through its workflow — you decide when it's done.",
  },
];
---

<HomepageSection index={1} label="reasons">
  <div class={reasonsGrid}>
    {
      reasons.map(({ Icon, title, subtitle, body }) => (
        <div class={item}>
          <span class={glyph}>
            <Icon size={22} />
          </span>
          <h3 class={itemHeading}>{title}</h3>
          <p class={itemSubtitle}>{subtitle}</p>
          <p class={cardBody}>{body}</p>
        </div>
      ))
    }
  </div>
</HomepageSection>
