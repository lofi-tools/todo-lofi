---
import { css } from "styled-system/css";
import AppMockup from "./AppMockup.astro";
import EditorWindow from "./EditorWindow.astro";
import type { FileTreeEntry } from "./fileTree";
import { backdropSurface, threadLayer, threadNode, threadPath } from "./styles";

const websiteFiles: FileTreeEntry[] = [
  { name: "src", depth: 0, folder: true },
  { name: "components", depth: 1, folder: true },
  { name: "Editor.tsx", depth: 2, type: "TSX", tone: "accent" },
  { name: "Button.tsx", depth: 2, type: "TSX", tone: "accent" },
  { name: "assets", depth: 0, folder: true },
  { name: "hero.png", depth: 1, type: "PNG", tone: "warning" },
];

const apiFiles: FileTreeEntry[] = [
  { name: "src", depth: 0, folder: true },
  { name: "router.ts", depth: 1, type: "TS", tone: "accent" },
  { name: "schema.json", depth: 1, type: "JSON", tone: "info" },
  { name: "sync.py", depth: 1, type: "PY", tone: "success" },
];

const windows = [
  {
    title: "project · todo-list",
    files: websiteFiles,
    editor: { name: "Editor.tsx", lines: 11 },
    thread: "todo-list",
  },
  {
    title: "project · recipe app",
    files: apiFiles,
    editor: { name: "router.ts", lines: 11 },
    thread: "recipe-app",
  },
];

const tags = [
  { name: "todo-list", thread: "todo-list" },
  { name: "recipe app", thread: "recipe-app" },
  { name: "money tracker" },
];

/** How far the second window sits past the first. */
const OFFSET = 18;

/**
 * Project directories: the Taskstream list on the left, and two editor windows
 * on the right — one per open project, offset like loose windows on a desktop.
 * A thread runs from each project to the window it is open in.
 */
const root = css({
  position: "relative",
  display: "flex",
  flexDirection: { base: "column", md: "row" },
  gap: "3",
  alignItems: "stretch",
  p: "3",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
  // A desktop-shaped canvas. The ratio is bounded rather than pinned, so the
  // bounds take over when the tab is narrow (the windows would be squat) or
  // very wide (the app window would be a letterbox).
  md: {
    aspectRatio: "3 / 2",
    minH: "210px",
    maxH: "330px",
  },
});

/**
 * Both windows sit in one grid cell so they keep a common size; the trailing
 * padding is the room their offsets need to stay inside the illustration.
 *
 * From `md` up they float over the app window's right-hand side, the way loose
 * windows sit on a desktop, instead of being given their own column.
 */
const windowStack = css({
  display: "grid",
  flexShrink: "0",
  w: "full",
  pr: `calc(var(--spacing-3) + ${OFFSET}px)`,
  pb: `calc(var(--spacing-3) + ${OFFSET}px)`,
  md: {
    position: "absolute",
    right: "3",
    bottom: "3",
    w: "56%",
  },
});

const windowSlot = css({ gridColumn: "1", gridRow: "1", display: "flex", minW: "0" });
---

<div class={`${root} ${backdropSurface}`} data-threads>
  <AppMockup folderTags tagsLabel="projects" tags={tags} taskRows={5} />

  <div class={windowStack}>
    {
      windows.map((entry, index) => (
        <div
          class={windowSlot}
          style={{ transform: `translate(${index * OFFSET}px, ${index * OFFSET}px)`, zIndex: index + 1 }}
        >
          <EditorWindow
            title={entry.title}
            files={entry.files}
            editor={entry.editor}
            thread={entry.thread}
          />
        </div>
      ))
    }
  </div>

  <svg class={threadLayer} data-thread-svg aria-hidden="true">
    <g data-thread="todo-list" data-from="todo-list" data-to="todo-list">
      <path class={threadPath} data-thread-path></path>
      <circle class={threadNode} r="2.5" data-thread-node></circle>
      <circle class={threadNode} r="2.5" data-thread-node></circle>
    </g>
    <g data-thread="recipe-app" data-from="recipe-app" data-to="recipe-app">
      <path class={threadPath} data-thread-path></path>
      <circle class={threadNode} r="2.5" data-thread-node></circle>
      <circle class={threadNode} r="2.5" data-thread-node></circle>
    </g>
  </svg>
</div>

<script>
  import { observeThreads } from "./threads";

  observeThreads();
</script>
