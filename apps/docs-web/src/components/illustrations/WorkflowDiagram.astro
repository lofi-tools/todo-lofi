---
import { css } from "styled-system/css";
import IllustrationFrame from "./IllustrationFrame.astro";

/**
 * The coding workflow as a flowchart: the happy path runs left to right in one
 * row, and the reject/feedback loop is the only thing that needs a second row.
 * It is a diagram rather than a screen replica, so it draws the loop the app
 * actually runs.
 */
const diagram = css({ w: "full", h: "auto", display: "block" });

const box = css({ fill: "surface.active", stroke: "border.strong", strokeWidth: "1.5" });
const decisionShape = css({ fill: "surface.active", stroke: "accent.text", strokeWidth: "1.5" });
const stepLabel = css({ fill: "fg.default", fontFamily: "mono", fontSize: "9.5px" });
const branchLabel = css({ fill: "fg.subtle", fontFamily: "mono", fontSize: "8.5px" });
const flow = css({ fill: "none", stroke: "border.strong", strokeWidth: "1.5" });
const feedback = css({ fill: "none", stroke: "accent.text", strokeWidth: "1.5", opacity: "0.85" });

const head = css({ fill: "border.strong" });
const feedbackHead = css({ fill: "accent.text", opacity: "0.85" });
---

<IllustrationFrame title="workflow · coding">
  <svg
    class={diagram}
    viewBox="0 0 472 92"
    role="img"
    aria-label="A task moves left to right from Interview to Spec to Implement to Review. Review asks whether the work is approved: approved work merges, while a rejection loops back below the row to Spec so the feature is re-specified and re-implemented."
  >
    <defs>
      <marker
        id="flow-head"
        markerWidth="6"
        markerHeight="6"
        refX="5"
        refY="3"
        orient="auto"
        markerUnits="strokeWidth"
      >
        <path class={head} d="M0 0L6 3L0 6Z" />
      </marker>
      <marker
        id="flow-head-back"
        markerWidth="6"
        markerHeight="6"
        refX="5"
        refY="3"
        orient="auto"
        markerUnits="strokeWidth"
      >
        <path class={feedbackHead} d="M0 0L6 3L0 6Z" />
      </marker>
    </defs>

    <rect class={box} x="12" y="10" width="62" height="36" rx="8" />
    <rect class={box} x="84" y="10" width="62" height="36" rx="8" />
    <rect class={box} x="156" y="10" width="62" height="36" rx="8" />
    <rect class={box} x="228" y="10" width="62" height="36" rx="8" />
    <polygon class={decisionShape} points="338,10 376,28 338,46 300,28" />
    <rect class={box} x="398" y="10" width="62" height="36" rx="8" />

    <path class={flow} d="M74 28H84" marker-end="url(#flow-head)" />
    <path class={flow} d="M146 28H156" marker-end="url(#flow-head)" />
    <path class={flow} d="M218 28H228" marker-end="url(#flow-head)" />
    <path class={flow} d="M290 28H300" marker-end="url(#flow-head)" />
    <path class={flow} d="M376 28H398" marker-end="url(#flow-head)" />
    <path class={feedback} d="M338 46V76H115V46" marker-end="url(#flow-head-back)" />

    <text class={stepLabel} x="43" y="31.5" text-anchor="middle">Interview</text>
    <text class={stepLabel} x="115" y="31.5" text-anchor="middle">Spec</text>
    <text class={stepLabel} x="187" y="31.5" text-anchor="middle">Implement</text>
    <text class={stepLabel} x="259" y="31.5" text-anchor="middle">Review</text>
    <text class={stepLabel} x="338" y="31.5" text-anchor="middle">approved?</text>
    <text class={stepLabel} x="429" y="31.5" text-anchor="middle">Merge</text>

    <text class={branchLabel} x="387" y="22" text-anchor="middle">yes</text>
    <text class={branchLabel} x="226" y="70" text-anchor="middle">no · re-spec, re-code</text>
  </svg>
</IllustrationFrame>
