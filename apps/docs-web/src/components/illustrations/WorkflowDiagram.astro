---
import { css } from "styled-system/css";
import IllustrationFrame from "./IllustrationFrame.astro";
import { caption } from "./styles";

/**
 * The coding workflow as a flowchart: five steps in two rows, with the review
 * decision splitting the run into a merge or a re-spec. It is a diagram rather
 * than a screen replica, so it draws the loop the app actually runs.
 */
const diagram = css({ w: "full", h: "auto", display: "block" });

const box = css({ fill: "surface.active", stroke: "border.strong", strokeWidth: "1.5" });
const decisionShape = css({ fill: "surface.active", stroke: "accent.text", strokeWidth: "1.5" });
const stepLabel = css({ fill: "fg.default", fontFamily: "mono", fontSize: "9.5px" });
const branchLabel = css({ fill: "fg.subtle", fontFamily: "mono", fontSize: "8px" });
const flow = css({ fill: "none", stroke: "border.strong", strokeWidth: "1.5" });
const feedback = css({ fill: "none", stroke: "accent.text", strokeWidth: "1.5", opacity: "0.85" });

const head = css({ fill: "border.strong" });
const feedbackHead = css({ fill: "accent.text", opacity: "0.85" });
---

<IllustrationFrame title="workflow · coding">
  <svg
    class={diagram}
    viewBox="0 0 460 172"
    role="img"
    aria-label="A task moves from Interview to Spec to Implement, then to Review. Review asks whether the work is approved: approved work merges, and a rejection loops back to Spec so the feature is re-specified and re-implemented."
  >
    <defs>
      <marker
        id="flow-head"
        markerWidth="6"
        markerHeight="6"
        refX="5"
        refY="3"
        orient="auto"
        markerUnits="strokeWidth"
      >
        <path class={head} d="M0 0L6 3L0 6Z" />
      </marker>
      <marker
        id="flow-head-back"
        markerWidth="6"
        markerHeight="6"
        refX="5"
        refY="3"
        orient="auto"
        markerUnits="strokeWidth"
      >
        <path class={feedbackHead} d="M0 0L6 3L0 6Z" />
      </marker>
    </defs>

    <rect class={box} x="17" y="22" width="126" height="38" rx="8" />
    <rect class={box} x="167" y="22" width="126" height="38" rx="8" />
    <rect class={box} x="317" y="22" width="126" height="38" rx="8" />

    <rect class={box} x="17" y="90" width="126" height="38" rx="8" />
    <polygon class={decisionShape} points="230,74 295,109 230,144 165,109" />
    <rect class={box} x="317" y="90" width="126" height="38" rx="8" />

    <path class={flow} d="M143 41H161" marker-end="url(#flow-head)" />
    <path class={flow} d="M293 41H311" marker-end="url(#flow-head)" />
    <path class={flow} d="M380 60V84" marker-end="url(#flow-head)" />
    <path class={flow} d="M317 109H301" marker-end="url(#flow-head)" />
    <path class={flow} d="M230 144V158H80V130" marker-end="url(#flow-head)" />
    <path class={feedback} d="M165 109H154V14H205V20" marker-end="url(#flow-head-back)" />

    <text class={stepLabel} x="80" y="44.5" text-anchor="middle">Interview</text>
    <text class={stepLabel} x="230" y="44.5" text-anchor="middle">Spec</text>
    <text class={stepLabel} x="380" y="44.5" text-anchor="middle">Implement</text>
    <text class={stepLabel} x="80" y="112.5" text-anchor="middle">Merge</text>
    <text class={stepLabel} x="230" y="112.5" text-anchor="middle">approved?</text>
    <text class={stepLabel} x="380" y="112.5" text-anchor="middle">Review</text>

    <text class={branchLabel} x="238" y="153" text-anchor="start">yes</text>
    <text class={branchLabel} x="158" y="10" text-anchor="start">no · re-spec, re-code</text>
  </svg>

  <p class={caption}>
    Rejection does not throw the run away — it reopens the spec, so the next round starts from
    the objection.
  </p>
</IllustrationFrame>
