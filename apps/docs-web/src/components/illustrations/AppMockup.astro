---
import { css } from "styled-system/css";
import { Folder } from "web-design-system/icons";
import PlaceholderList from "./PlaceholderList.astro";
import { dot, paneLabel, windowBar, windowSurface } from "./styles";

interface Tag {
  /** Tag name including its leading `#`. */
  name: string;
  /**
   * Optional id of an external surface this tag connects to. The owning
   * illustration draws the connector thread from the rendered tag row.
   */
  thread?: string;
}

interface Props {
  /** Window title shown in the title bar. */
  title?: string;
  /** Heading over the tags nav. */
  tagsLabel?: string;
  tags: Tag[];
  /** Heading over the task list. */
  listLabel?: string;
  /** Low-fidelity rows shown in the list. */
  taskRows?: number;
  /** Draw each tag as a project directory, with the folder glyph the app uses. */
  folderTags?: boolean;
}

/**
 * The window adds a third column when the caller fills the `details` slot, the
 * way the app puts the selected task's pane beside its list.
 */
const hasDetails = Astro.slots.has("details");

const {
  title = "Taskstream",
  tagsLabel = "tags",
  tags,
  listLabel = "today",
  taskRows = 6,
  folderTags = false,
} = Astro.props;

const window = css({
  flex: "1",
  minW: "0",
  display: "flex",
  flexDirection: "column",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
  overflow: "hidden",
});

const windowTitle = css({ ml: "2", fontFamily: "mono", fontSize: "2xs", color: "fg.subtle" });

// The nav column is sized by what it holds rather than pinned to a width: tag
// names are single lines of mono text, and a fixed track clips the longer ones.
const navTrack = "minmax(0, auto)";

const windowGrid = css({
  display: "grid",
  gridTemplateColumns: `${navTrack} minmax(0, 1fr)`,
  flex: "1",
  minH: "40",
});

const windowGridWithDetails = css({
  gridTemplateColumns: `${navTrack} minmax(0, 1fr) minmax(0, 170px)`,
});

const detailsPane = css({
  display: "flex",
  flexDirection: "column",
  gap: "2",
  minW: "0",
  p: "3",
  borderLeftWidth: "hairline",
  borderLeftStyle: "solid",
  borderLeftColor: "border.subtle",
});

const tagsNav = css({
  display: "flex",
  flexDirection: "column",
  gap: "1",
  p: "2",
  minW: "0",
  borderRightWidth: "hairline",
  borderRightStyle: "solid",
  borderRightColor: "border.subtle",
});

const tagRow = css({
  display: "flex",
  alignItems: "center",
  justifyContent: "space-between",
  gap: "2",
  px: "1.5",
  py: "1.5",
  borderRadius: "sm",
});

const tagLabel = css({ display: "inline-flex", alignItems: "center", gap: "1.5", minW: "0" });
const tagIcon = css({ display: "inline-flex", flexShrink: "0", color: "fg.subtle" });
const tagName = css({ fontFamily: "mono", fontSize: "xs", color: "fg.default", whiteSpace: "nowrap" });

const mainPane = css({ display: "flex", flexDirection: "column", p: "3" });
---

<div class={`${window} ${windowSurface}`}>
  <div class={windowBar}>
    <span class={dot} />
    <span class={dot} />
    <span class={windowTitle}>{title}</span>
  </div>
  <div class={hasDetails ? `${windowGrid} ${windowGridWithDetails}` : windowGrid}>
    <div class={tagsNav}>
      <span class={paneLabel}>{tagsLabel}</span>
      {
        tags.map((tag) => (
          <span class={tagRow} data-thread-from={tag.thread}>
            <span class={tagLabel}>
              {folderTags && (
                <span class={tagIcon}>
                  <Folder size={13} />
                </span>
              )}
              <span class={tagName}>{tag.name}</span>
            </span>
          </span>
        ))
      }
    </div>
    <div class={mainPane}>
      <span class={paneLabel}>{listLabel}</span>
      <PlaceholderList rows={taskRows} spread />
    </div>
    {hasDetails && (
      <div class={detailsPane}>
        <slot name="details" />
      </div>
    )}
  </div>
</div>
