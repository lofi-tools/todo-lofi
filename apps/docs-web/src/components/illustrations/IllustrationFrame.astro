---
import { css } from "styled-system/css";
import { dot } from "./styles";

interface Props {
  /** Name shown in the window bar; the bar is the illustration's chrome. */
  title?: string;
}

const { title } = Astro.props;

const root = css({
  display: "flex",
  flexDirection: "column",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border",
  bg: "surface.subtle",
  overflow: "hidden",
});

const bar = css({
  display: "flex",
  alignItems: "center",
  gap: "1.5",
  px: "3",
  h: "7",
  borderBottomWidth: "hairline",
  borderBottomStyle: "solid",
  borderBottomColor: "border.subtle",
});

const titleStyle = css({ ml: "2", fontFamily: "mono", fontSize: "2xs", color: "fg.subtle" });

const body = css({ display: "flex", flexDirection: "column", gap: "2", p: "3", flex: "1" });
---

<div class={root}>
  <div class={bar}>
    <span class={dot} />
    <span class={dot} />
    {title && <span class={titleStyle}>{title}</span>}
  </div>
  <div class={body}>
    <slot />
  </div>
</div>
