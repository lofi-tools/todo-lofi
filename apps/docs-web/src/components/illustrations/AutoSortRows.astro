---
import { css } from "styled-system/css";
import { Flag } from "web-design-system/icons";
import { backdropSurface } from "./styles";

interface Task {
  id: string;
  label: string;
  importance: "low" | "medium" | "high";
  /** Priority score from importance alone. */
  base: number;
  /** Human label for the deadline. */
  due: string;
  /** Simulated-clock hour the deadline lands on, or null for deadlines days out. */
  dueHour: number | null;
  /** Deadline pressure added as the deadline arrives. */
  pressure: number;
  /** Period (ms) and phase of the score's continuous drift. */
  driftPeriod: number;
  phase: number;
}

/**
 * A miniature task list for the "sorted for you" story. Every row carries a
 * priority score that drifts continuously and the list re-sorts on that score,
 * so the order is always a consequence of priority. Feed the dog has a 6pm
 * deadline: as it approaches, a warning flashes and deadline pressure lifts the
 * task to the top. The whole cycle loops.
 */
const tasks: Task[] = [
  { id: "ship", label: "Ship the release", importance: "high", base: 3.5, due: "in 5d", dueHour: null, pressure: 0, driftPeriod: 1250, phase: 0 },
  { id: "sam", label: "Reply to Sam", importance: "medium", base: 2.2, due: "in 3d", dueHour: null, pressure: 0, driftPeriod: 1700, phase: 2.1 },
  { id: "dog", label: "Feed the dog", importance: "low", base: 1.1, due: "6:00 PM", dueHour: 18, pressure: 2.8, driftPeriod: 900, phase: 4.2 },
];

/** Simulated clock and animation constants, shared with the client script. */
const sim = {
  /** Simulated hours the loop covers; the dog's 6pm deadline is the end. */
  startHour: 15.5,
  endHour: 18,
  /** Hours before a deadline at which the row starts warning. */
  warnHours: 1.5,
  /**
   * Progress at which pressure first tops out, and how much it keeps climbing
   * past it. The tail keeps a deadline task rising to the end of the loop, so
   * it holds the top spot instead of peaking and dropping back.
   */
  pressureRamp: 0.55,
  pressureTail: 0.6,
  /** Amplitude of the per-task score drift. */
  driftAmplitude: 0.18,
  /** Loop length and reorder duration, in ms. */
  loop: 9000,
  motion: 420,
};

const root = css({
  display: "flex",
  flexDirection: "column",
  gap: "2",
  p: "3",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
});

const list = css({ display: "flex", flexDirection: "column", gap: "2" });

const rowStyle = css({
  display: "flex",
  alignItems: "center",
  gap: "2",
  px: "3",
  py: "2.5",
  borderRadius: "md",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
  backgroundImage:
    "linear-gradient(160deg, token(colors.surface.hover) 0%, token(colors.surface.elevated) 55%, token(colors.surface.subtle) 100%)",
  willChange: "transform",
});

const priority = css({
  display: "inline-flex",
  alignItems: "center",
  gap: "1",
  flexShrink: "0",
  color: "fg.subtle",
});

const score = css({
  fontFamily: "mono",
  fontSize: "2xs",
  color: "fg.subtle",
  fontVariantNumeric: "tabular-nums",
});

const rowLabel = css({
  flex: "1",
  minW: "0",
  overflow: "hidden",
  textOverflow: "ellipsis",
  fontSize: "sm",
  color: "fg.default",
  whiteSpace: "nowrap",
});

const signals = css({ display: "inline-flex", alignItems: "center", gap: "2", flexShrink: "0" });

/** The warning is hidden until the script flags a closing deadline, then it pulses. */
const warning = css({
  display: "none",
  alignItems: "center",
  fontFamily: "mono",
  fontSize: "2xs",
  textTransform: "uppercase",
  letterSpacing: "wide",
  color: "warning",
  bg: "warning.subtle",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "warning",
  borderRadius: "sm",
  px: "1.5",
  py: "0.5",
  whiteSpace: "nowrap",
  animation: "pulse 1.1s ease-in-out infinite",
  "&[data-show]": { display: "inline-flex" },
});

const importance = css({
  fontFamily: "mono",
  fontSize: "2xs",
  textTransform: "uppercase",
  letterSpacing: "wide",
  color: "fg.muted",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
  backgroundImage:
    "linear-gradient(180deg, token(colors.surface.active) 0%, token(colors.surface.hover) 100%)",
  borderRadius: "sm",
  px: "1.5",
  py: "0.5",
  "&[data-importance=\"high\"]": { color: "accent.text", borderColor: "accent" },
  "&[data-importance=\"medium\"]": { color: "fg.muted" },
});

const due = css({
  fontFamily: "mono",
  fontSize: "2xs",
  color: "fg.subtle",
  minW: "8",
  textAlign: "right",
});
---

<div class={`${root} ${backdropSurface}`} data-reorder-rows>
  <script type="application/json" data-reorder-tasks set:html={JSON.stringify({ tasks, sim })} />
  <div class={list} data-reorder-list>
    {
      tasks.map((task) => (
        <div class={rowStyle} data-row-id={task.id}>
          <span class={rowLabel}>{task.label}</span>
          <span class={signals}>
            <span class={priority}>
              <Flag size={13} />
              <span class={score} data-row-score>
                {task.base.toFixed(2)}
              </span>
            </span>
            <span class={warning} data-row-warning>
              due soon
            </span>
            <span class={importance} data-row-importance data-importance={task.importance}>
              {task.importance}
            </span>
            <span class={due} data-row-due>
              {task.due}
            </span>
          </span>
        </div>
      ))
    }
  </div>
</div>

<script>
  interface AnimTask {
    id: string;
    base: number;
    dueHour: number | null;
    pressure: number;
    driftPeriod: number;
    phase: number;
  }

  interface Sim {
    startHour: number;
    endHour: number;
    warnHours: number;
    pressureRamp: number;
    pressureTail: number;
    driftAmplitude: number;
    loop: number;
    motion: number;
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const root of document.querySelectorAll<HTMLElement>("[data-reorder-rows]")) {
    const list = root.querySelector<HTMLElement>("[data-reorder-list]");
    const source = root.querySelector<HTMLScriptElement>("[data-reorder-tasks]");
    if (!list || !source?.textContent) continue;

    const { tasks, sim } = JSON.parse(source.textContent) as { tasks: AnimTask[]; sim: Sim };
    if (tasks.length === 0) continue;

    const rows = new Map<string, HTMLElement>();
    for (const node of list.querySelectorAll<HTMLElement>("[data-row-id]")) {
      const id = node.dataset.rowId;
      if (id) rows.set(id, node);
    }

    const span = sim.endHour - sim.startHour;
    const started = performance.now();
    let lastOrder = "";

    const reorder = (order: AnimTask[]) => {
      const before = new Map<string, DOMRect>();
      for (const [id, node] of rows) before.set(id, node.getBoundingClientRect());

      for (const task of order) {
        const node = rows.get(task.id);
        if (node) list.append(node);
      }

      if (reduceMotion) return;
      for (const [id, node] of rows) {
        const first = before.get(id);
        if (!first) continue;
        const last = node.getBoundingClientRect();
        const deltaY = first.top - last.top;
        if (deltaY === 0) continue;
        node.animate(
          [{ transform: `translateY(${deltaY}px)` }, { transform: "translateY(0)" }],
          { duration: sim.motion, easing: "cubic-bezier(0.2, 0, 0, 1)" },
        );
      }
    };

    const frame = (now: number) => {
      if (root.offsetParent !== null) {
        const elapsed = now - started;
        const progress = (elapsed % sim.loop) / sim.loop;
        const hour = sim.startHour + progress * span;

        const scored = tasks.map((task) => {
          const hoursUntil = task.dueHour === null ? null : task.dueHour - hour;
          // Pressure shoots up early, then keeps climbing to the end of the
          // loop so the deadline task stays on top for the rest of the cycle.
          const ramp = Math.min(1, progress / sim.pressureRamp);
          const tail = Math.max(0, progress - sim.pressureRamp) * sim.pressureTail;
          const pressure = task.pressure * (ramp + tail);
          const drift =
            sim.driftAmplitude * Math.sin((elapsed / task.driftPeriod) * Math.PI * 2 + task.phase);
          return {
            task,
            score: task.base + pressure + drift,
            warn: hoursUntil !== null && hoursUntil <= sim.warnHours && hoursUntil > 0,
          };
        });

        for (const item of scored) {
          const node = rows.get(item.task.id);
          if (!node) continue;
          const scoreEl = node.querySelector<HTMLElement>("[data-row-score]");
          if (scoreEl) scoreEl.textContent = item.score.toFixed(2);
          const warnEl = node.querySelector<HTMLElement>("[data-row-warning]");
          if (warnEl) warnEl.toggleAttribute("data-show", item.warn);
        }

        const order = [...scored].sort((a, b) => b.score - a.score).map((item) => item.task);
        const key = order.map((task) => task.id).join(",");
        if (key !== lastOrder) {
          lastOrder = key;
          reorder(order);
        }
      }

      window.requestAnimationFrame(frame);
    };

    window.requestAnimationFrame(frame);
  }
</script>
