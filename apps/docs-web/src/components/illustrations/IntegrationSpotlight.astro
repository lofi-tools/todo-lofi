---
import { css } from "styled-system/css";
import AsanaIcon from "./icons/AsanaIcon.astro";
import CalendarIcon from "./icons/CalendarIcon.astro";
import DatadogIcon from "./icons/DatadogIcon.astro";
import DriveIcon from "./icons/DriveIcon.astro";
import FigmaIcon from "./icons/FigmaIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import GmailIcon from "./icons/GmailIcon.astro";
import GoogleTasksIcon from "./icons/GoogleTasksIcon.astro";
import IntercomIcon from "./icons/IntercomIcon.astro";
import JiraIcon from "./icons/JiraIcon.astro";
import LinearIcon from "./icons/LinearIcon.astro";
import SlackIcon from "./icons/SlackIcon.astro";
import TodoistIcon from "./icons/TodoistIcon.astro";
import VercelIcon from "./icons/VercelIcon.astro";
import ZapierIcon from "./icons/ZapierIcon.astro";

const root = css({
  position: "relative",
  overflow: "hidden",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
  bg: "#070708",
});

interface Tile {
  o: number;
  label: string;
  Icon: typeof GithubIcon;
}

// Rows scroll as marquee strips, alternating direction, so tile positions
// are flow-based, not absolute. Every glyph is normalized inside its own
// icon component to fill the same ~60% of the viewport, and all render at
// the same size via the tile rule below.
const rowA: Tile[] = [
  { o: 0.55, label: "Slack", Icon: SlackIcon },
  { o: 0.95, label: "Zapier", Icon: ZapierIcon },
  { o: 0.95, label: "Linear", Icon: LinearIcon },
  { o: 0.6, label: "Drive", Icon: DriveIcon },
  { o: 0.9, label: "Todoist", Icon: TodoistIcon },
];

// Five tiles per row so `space-around` divides the same leftover in every
// strip: with six in one row and five in the others, the horizontal gaps
// between tiles differed row to row.
const rowB: Tile[] = [
  { o: 0.7, label: "Asana", Icon: AsanaIcon },
  { o: 1, label: "Vercel", Icon: VercelIcon },
  { o: 0.9, label: "Datadog", Icon: DatadogIcon },
  { o: 0.95, label: "GitHub", Icon: GithubIcon },
  { o: 0.8, label: "Jira", Icon: JiraIcon },
];

const rowC: Tile[] = [
  { o: 0.55, label: "Figma", Icon: FigmaIcon },
  { o: 0.92, label: "Gmail", Icon: GmailIcon },
  { o: 0.92, label: "Calendar", Icon: CalendarIcon },
  { o: 0.62, label: "Intercom", Icon: IntercomIcon },
  { o: 0.88, label: "Google Tasks", Icon: GoogleTasksIcon },
];

const rows = [rowA, rowB, rowC];

const centerBody = `<defs><linearGradient id="spotCloud" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#dcdce1"/></linearGradient></defs><g fill="url(#spotCloud)"><circle cx="22" cy="36" r="10"/><circle cx="32" cy="29" r="13"/><circle cx="43" cy="36" r="10"/><rect x="16" y="34" width="34" height="13" rx="6.5"/></g>`;
---

<div class={root} data-spotlight role="img" aria-label="Scrolling rows of integration tiles with Taskstream sync lit in the center">
  <div class="spot-stage" data-spot-grid>
    <div class="spot-ring" aria-hidden="true"></div>
    {rows.map((row, index) => (
      <div class={`spot-row${index === 1 ? " spot-reverse" : ""}`}>
        {[0, 1].map((copy) => (
          <div class="spot-track" aria-hidden={copy === 1 ? "true" : undefined}>
            {row.map((tile) => (
              <div class="spot-tile" style={`--o:${tile.o}`} title={tile.label}>
                <tile.Icon />
              </div>
            ))}
          </div>
        ))}
      </div>
    ))}
    <div class="spot-tile spot-center" title="Taskstream sync">
      <svg viewBox="0 0 64 64" aria-hidden="true" set:html={centerBody} />
    </div>
  </div>
</div>

<style>
  [data-spotlight] {
    background: linear-gradient(160deg, rgba(94,106,210,.10) 0%, #1b1b21 30%, #121217 66%, #0b0b0f 100%);
  }
  .spot-stage {
    position: relative;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--spot-gap, 18px);
    padding: var(--spot-gap, 18px) 0;
    transition: transform 0.25s ease-out;
    -webkit-mask-image: radial-gradient(ellipse 72% 88% at 50% 50%, #000 52%, rgba(0,0,0,.72) 70%, rgba(0,0,0,.28) 82%, transparent 95%);
    mask-image: radial-gradient(ellipse 72% 88% at 50% 50%, #000 52%, rgba(0,0,0,.72) 70%, rgba(0,0,0,.28) 82%, transparent 95%);
  }
  @media (max-width: 640px) {
    .spot-stage { aspect-ratio: 4 / 5; }
  }
  .spot-ring {
    position: absolute;
    left: 50%; top: 50%;
    width: 78%; aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, transparent 60%, rgba(255,255,255,.02) 66%, transparent 74%);
    pointer-events: none;
  }
  .spot-row {
    display: flex;
    overflow: hidden;
  }
  .spot-track {
    display: flex;
    flex-shrink: 0;
    gap: var(--spot-gap, 18px);
    padding-right: var(--spot-gap, 18px);
    min-width: 100%;
    justify-content: space-around;
    animation: spot-scroll 40s linear infinite;
  }
  .spot-reverse .spot-track {
    animation-direction: reverse;
  }
  .spot-row:hover .spot-track {
    animation-play-state: paused;
  }
  @keyframes spot-scroll {
    to { transform: translateX(-100%); }
  }
  .spot-tile {
    width: clamp(88px, 12%, 150px);
    flex-shrink: 0;
    aspect-ratio: 1;
    border-radius: 13%;
    background: linear-gradient(160deg, #17171a 0%, #101013 60%, #0c0c0e 100%);
    border: 1px solid #1e1e22;
    box-shadow: 0 14px 34px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.03);
    display: grid;
    place-items: center;
    color: #66666c;
    opacity: var(--o, 1);
    transition: opacity .45s ease, border-color .25s ease;
  }
  /* :global() so the rule reaches the <svg> inside the icon components: an
     Astro <style> block is scoped to the elements this template renders, so a
     plain `.spot-tile svg` selector never matched a child component's glyph
     and the tiles drew it at its default size instead. */
  .spot-tile :global(svg) { width: 48%; height: 48%; display: block; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .spot-tile:hover { border-color: #2a2a30; }
  .spot-tile:hover :global(svg) { transform: scale(1.06); }
  .spot-center {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: clamp(104px, 14%, 176px);
    background: linear-gradient(160deg, #26262b 0%, #1a1a1f 60%, #141418 100%);
    border-color: #33333a;
    color: #f4f4f6;
    opacity: 1;
    box-shadow: 0 0 46px rgba(255,255,255,.07), 0 14px 34px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.08);
    z-index: 2;
  }
  .spot-center svg {
    /* Same box as a tile glyph: the cloud mark sits inside its own viewBox
       with room to spare, so it reads lighter than the brand glyphs beside
       it even when both are given the same share of the tile. */
    width: 48%; height: 48%;
    filter: drop-shadow(0 0 16px rgba(255,255,255,.35));
    animation: spot-pulse 4s ease-in-out infinite;
  }
  @keyframes spot-pulse {
    0%,100% { filter: drop-shadow(0 0 12px rgba(255,255,255,.25)); }
    50% { filter: drop-shadow(0 0 28px rgba(255,255,255,.50)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .spot-center svg { animation: none; }
    .spot-track { animation: none; }
    .spot-stage { transition: none; }
  }
</style>

<script>
  const panel = document.querySelector("[data-spotlight]");
  const grid = panel?.querySelector("[data-spot-grid]");
  if (panel && grid instanceof HTMLElement) {
    panel.addEventListener("mousemove", (event) => {
      const pointer = event as MouseEvent;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const rect = panel.getBoundingClientRect();
      const x = (pointer.clientX - rect.left) / rect.width - 0.5;
      const y = (pointer.clientY - rect.top) / rect.height - 0.5;
      grid.style.transform = `translate(${x * 12}px, ${y * 10}px)`;
    });
    panel.addEventListener("mouseleave", () => {
      grid.style.transform = "";
    });
  }
</script>
