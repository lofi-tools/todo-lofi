---
import { css } from "styled-system/css";
import AppMockup from "./AppMockup.astro";
import PlaceholderList from "./PlaceholderList.astro";
import { label, paneLabel, threadLayer, threadNode, threadPath, windowSurface } from "./styles";

/**
 * Two-way sync: a Todoist list beside the Taskstream app, with a loose thread
 * drawn from each synced project to the tag it maps to. The external list sits
 * on the left, so the threads leave the tag rows straight into it instead of
 * crossing the app's main pane.
 */
// Containment only: the synchronised panels carry the surface, so the root
// stays transparent and borderless; it is only here to hold them and to give
// the connector threads something to measure against.
const root = css({
  position: "relative",
  display: "flex",
  flexDirection: { base: "column", md: "row" },
  gap: "3",
  alignItems: "stretch",
});

const tags = [
  { name: "#inbox" },
  { name: "#work", thread: "work" },
  { name: "#life admin", thread: "life" },
  { name: "#home" },
];

/** The external list: the Todoist projects stacked from the panel's top. */
const external = css({
  display: "flex",
  flexDirection: "column",
  gap: "3",
  flexShrink: "0",
  w: { base: "full", md: "132px" },
  p: "2",
  borderRadius: "lg",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
});

const projectGroup = css({ display: "flex", flexDirection: "column", gap: "1.5" });

/** The project's tasks, indented so the project row reads as their heading. */
const projectTasks = css({ pl: "2" });

const projectRow = css({
  display: "flex",
  alignItems: "center",
  gap: "2",
  px: "2",
  py: "2",
  borderRadius: "md",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
  backgroundImage:
    "linear-gradient(160deg, token(colors.surface.hover) 0%, token(colors.surface.elevated) 55%, token(colors.surface.subtle) 100%)",
});

const projectMark = css({
  w: "2.5",
  h: "2.5",
  flexShrink: "0",
  borderRadius: "xs",
  bg: "accent.text",
  opacity: "0.8",
});
---

<div class={root} data-threads>
  <div class={`${external} ${windowSurface}`}>
    <span class={paneLabel}>todoist</span>
    <div class={projectGroup}>
      <span class={projectRow} data-thread-to="work">
        <span class={projectMark} />
        <span class={label}>work</span>
      </span>
      <div class={projectTasks}>
        <PlaceholderList rows={3} />
      </div>
    </div>
    <div class={projectGroup}>
      <span class={projectRow} data-thread-to="life">
        <span class={projectMark} />
        <span class={label}>life admin</span>
      </span>
      <div class={projectTasks}>
        <PlaceholderList rows={3} />
      </div>
    </div>
  </div>

  <AppMockup tags={tags} taskRows={4} />

  <svg class={threadLayer} data-thread-svg aria-hidden="true">
    <g data-thread="work" data-from="work" data-to="work">
      <path class={threadPath} data-thread-path />
      <circle class={threadNode} r="2.5" data-thread-node />
      <circle class={threadNode} r="2.5" data-thread-node />
    </g>
    <g data-thread="life" data-from="life" data-to="life">
      <path class={threadPath} data-thread-path />
      <circle class={threadNode} r="2.5" data-thread-node />
      <circle class={threadNode} r="2.5" data-thread-node />
    </g>
  </svg>
</div>

<script>
  import { observeThreads } from "./threads";

  observeThreads();
</script>
