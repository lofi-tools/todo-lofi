---
import { css } from "styled-system/css";
import { Flag, Repeat } from "web-design-system/icons";
import IllustrationFrame from "./IllustrationFrame.astro";
import { chip, mono, rowHead } from "./styles";

interface Task {
  id: string;
  label: string;
  /** Priority score, in mono so the ordering can be read as a number. */
  score: string;
  /** Trailing state: a deadline, or a repeat's own start time. */
  state: string;
  /** Whether the row carries the repeat rule. */
  repeats?: boolean;
}

/**
 * The same list at two moments. The point of putting them side by side is the
 * division of labour between the two features: the repeat decides *when* a task
 * enters the list, and the priority score decides *where* it lands. A looping
 * animation would show one of those at a time and a reader could miss either;
 * two moments hold both on screen at once.
 */
const before: Task[] = [
  { id: "ship", label: "Ship the release", score: "2.60", state: "in 5d" },
  { id: "sam", label: "Reply to Sam", score: "1.90", state: "in 3d" },
];

/** The watering occurrence, before its own start time makes it doable. */
const waiting: Task = {
  id: "plants",
  label: "Water the plants",
  score: "0.90",
  state: "starts 18:00",
  repeats: true,
};

const after: Task[] = [
  { id: "plants", label: "Water the plants", score: "3.40", state: "due now", repeats: true },
  ...before,
];

const rule = "every 3 days";

const moments = css({
  display: "grid",
  gridTemplateColumns: { base: "1fr", md: "repeat(2, minmax(0, 1fr))" },
  gap: "2",
});

const moment = css({
  display: "flex",
  flexDirection: "column",
  gap: "2",
  p: "2",
  borderRadius: "md",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.subtle",
});

const momentHead = css({
  display: "flex",
  alignItems: "baseline",
  justifyContent: "space-between",
  gap: "2",
});

const clock = css({ fontFamily: "mono", fontSize: "xs", color: "fg.default" });
const momentNote = css({ fontFamily: "mono", fontSize: "2xs", color: "fg.subtle", textAlign: "right" });

const list = css({ display: "flex", flexDirection: "column", gap: "2" });

const task = css({
  display: "flex",
  alignItems: "center",
  gap: "2",
  px: "2",
  py: "1.5",
  borderRadius: "md",
  borderWidth: "hairline",
  borderStyle: "solid",
  borderColor: "border.strong",
  backgroundImage:
    "linear-gradient(160deg, token(colors.surface.hover) 0%, token(colors.surface.elevated) 55%, token(colors.surface.subtle) 100%)",
  // The occurrence that has just arrived is the only row the list moved, so it
  // is the only one outlined in accent — the reorder is visible without a
  // "moved" badge having to say so.
  "&[data-arrived]": { borderColor: "accent" },
});

const taskLabel = css({
  flex: "1",
  minW: "0",
  overflow: "hidden",
  textOverflow: "ellipsis",
  whiteSpace: "nowrap",
  fontSize: "xs",
  color: "fg.default",
});

const signals = css({ display: "inline-flex", alignItems: "center", gap: "2", flexShrink: "0" });

const repeatMark = css({ display: "inline-flex", color: "accent.text" });

const score = css({ display: "inline-flex", alignItems: "center", gap: "1", color: "fg.subtle" });

const scoreValue = css({
  fontFamily: "mono",
  fontSize: "2xs",
  fontVariantNumeric: "tabular-nums",
});

const state = css({
  fontFamily: "mono",
  fontSize: "2xs",
  color: "fg.subtle",
  whiteSpace: "nowrap",
  "&[data-due]": { color: "accent.text" },
});

/**
 * The occurrence that is not doable yet is drawn the way a blocked task is:
 * set aside in a dashed group, so "hidden until 18:00" reads as the app
 * holding it back rather than as a task the user has to remember.
 */
const waitingGroup = css({
  display: "flex",
  flexDirection: "column",
  gap: "2",
  p: "2",
  borderRadius: "md",
  borderWidth: "hairline",
  borderStyle: "dashed",
  borderColor: "border.strong",
  opacity: "0.72",
});

const waitingRow = css({ display: "flex", alignItems: "center", gap: "2", minW: "0" });

const waitingLabel = css({
  fontFamily: "mono",
  fontSize: "2xs",
  color: "fg.muted",
  overflow: "hidden",
  textOverflow: "ellipsis",
  whiteSpace: "nowrap",
});

const waitingScore = css({ ml: "auto", flexShrink: "0" });

// `chip` sets no display, so this adds the icon layout without a property
// collision between two utility classes.
const chipWithIcon = css({ display: "inline-flex", alignItems: "center", gap: "1" });
---

<IllustrationFrame title="today">
  <div class={rowHead}>
    <span class={mono}>sorted by priority score</span>
    <span class={`${chip} ${chipWithIcon}`}>
      <Repeat size={11} />
      {rule}
    </span>
  </div>

  <div class={moments}>
    <div class={moment}>
      <div class={momentHead}>
        <span class={clock}>17:55</span>
        <span class={momentNote}>occurrence not doable</span>
      </div>

      <div class={list}>
        {
          before.map((item) => (
            <div class={task}>
              <span class={taskLabel}>{item.label}</span>
              <span class={signals}>
                <span class={score}>
                  <Flag size={12} />
                  <span class={scoreValue}>{item.score}</span>
                </span>
                <span class={state}>{item.state}</span>
              </span>
            </div>
          ))
        }
      </div>

      <div class={waitingGroup}>
        <span class={mono}>repeat · hidden until 18:00</span>
        <span class={waitingRow}>
          <span class={repeatMark}>
            <Repeat size={12} />
          </span>
          <span class={waitingLabel}>{waiting.label}</span>
          <span class={`${score} ${waitingScore}`}>
            <Flag size={12} />
            <span class={scoreValue}>{waiting.score}</span>
          </span>
          <span class={state}>{waiting.state}</span>
        </span>
      </div>
    </div>

    <div class={moment}>
      <div class={momentHead}>
        <span class={clock}>18:00</span>
        <span class={momentNote}>occurrence due</span>
      </div>

      <div class={list}>
        {
          after.map((item) => (
            <div class={task} data-arrived={item.id === "plants" ? true : undefined}>
              <span class={taskLabel}>{item.label}</span>
              <span class={signals}>
                {item.repeats && (
                  <span class={repeatMark}>
                    <Repeat size={12} />
                  </span>
                )}
                <span class={score}>
                  <Flag size={12} />
                  <span class={scoreValue}>{item.score}</span>
                </span>
                <span class={state} data-due={item.id === "plants" ? true : undefined}>
                  {item.state}
                </span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</IllustrationFrame>
