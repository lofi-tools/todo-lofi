---
import { Badge } from 'web-design-system/components'
import Base from '../layouts/Base.astro'
import { companyContextForProvider, loadCatalog } from '../lib/catalog'
import {
  familyHref,
  formatDate,
  formatNumber,
  harnessHref,
  providerHref,
} from '../lib/format'

const catalog = await loadCatalog()
const openWeightModels = catalog.models.filter((model) => model.openWeights === true).length
const rootFamilies = catalog.families.filter((family) => family.parentFamilyId === null)
const providersByHarness = (harnessId: string) =>
  new Set(
    catalog.providerHarnesses
      .filter((link) => link.harnessId === harnessId)
      .map((link) => link.providerId),
  )
---

<Base
  title="Provider and model catalog"
  description="Compare coding-agent providers and models, their families, the harnesses they serve and benchmark definitions."
>
  <section class="hero">
    <p class="eyebrow">Provider and model catalog</p>
    <h1 class="h1">Know what you can run, and where it came from.</h1>
    <p class="lede">
      Browse coding-agent providers, the models they serve and the harnesses that can use them.
      One canonical model correlates every provider serving the same release, and model families
      are a tree rather than a flat label.
    </p>
    <div class="meta-row">
      <Badge tone="accent" variant="subtle">models.dev data</Badge>
      <span class="pill">Snapshot {formatDate(catalog.snapshot.generatedAt)}</span>
      <span class="pill">MIT licensed source</span>
    </div>
  </section>

  <div class="stats" aria-label="Snapshot totals">
    <div class="stat">
      <span class="stat__value">{formatNumber(catalog.providers.length)}</span>
      <span class="stat__label">providers</span>
    </div>
    <div class="stat">
      <span class="stat__value">{formatNumber(catalog.models.length)}</span>
      <span class="stat__label">provider model entries</span>
    </div>
    <div class="stat">
      <span class="stat__value">{formatNumber(catalog.canonicalModels.length)}</span>
      <span class="stat__label">canonical models</span>
    </div>
    <div class="stat">
      <span class="stat__value">{formatNumber(catalog.families.length)}</span>
      <span class="stat__label">model families</span>
    </div>
  </div>

  <section class="section" id="providers">
    <div class="section__head">
      <div>
        <h2>Browse by provider</h2>
        <p>
          {formatNumber(catalog.providers.length)} provider entries in this snapshot. A provider entry
          can be a company-level endpoint or one plan of a company.
          <a href="/companies">Browse companies and plans →</a>
        </p>
      </div>
      <label class="filter-field">
        <span>Search providers</span>
        <input type="search" data-provider-search placeholder="Provider name or id" autocomplete="off" />
      </label>
    </div>

    <div class="grid provider-grid">
      {
        catalog.providers.map((provider) => {
          const companyContext = companyContextForProvider(catalog, provider.providerId)
          return (
          <a
            class="card"
            href={providerHref(provider.providerId)}
            data-provider-card
            data-name={`${provider.name} ${provider.providerId} ${companyContext?.plan.name ?? ''} ${companyContext?.company.name ?? ''}`.toLowerCase()}
          >
            <h3>{provider.name}</h3>
            <p class="mono">{provider.providerId}</p>
            {companyContext && (
              <p class="small muted">
                {companyContext.plan.name} plan of {companyContext.company.name}
              </p>
            )}
            <p>
              {formatNumber(provider.modelCount)} models · {formatNumber(provider.openWeightCount)} open-weight
            </p>
            <div class="card__meta">
              {provider.retained && <span class="pill">Retained from an earlier snapshot</span>}
              {provider.planCount === 0 && <span class="pill">Plans not published</span>}
            </div>
          </a>
          )
        })
      }
    </div>
    <p class="empty" data-provider-empty hidden>No providers match that search.</p>
  </section>

  <section class="section" aria-label="Model families">
    <div class="section__head">
      <div>
        <h2>Model families</h2>
        <p>
          Families are a tree: a parent family's models include every descendant family.
          {formatNumber(catalog.families.length)} families are defined in this snapshot.
        </p>
      </div>
      <p><a href="/families">Browse all families →</a></p>
    </div>
    <div class="grid grid--2">
      {
        rootFamilies.slice(0, 8).map((family) => (
          <a class="card" href={familyHref(family.familyId)}>
            <h3>{family.name}</h3>
            <p class="mono">{family.familyId}</p>
            <p>{family.vendor ?? 'Vendor unknown'}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section" aria-label="Harnesses">
    <div class="section__head">
      <div>
        <h2>Harnesses</h2>
        <p>
          A harness is the coding agent a provider serves. Some providers are exclusive to one
          harness; for example Anthropic-served models are Claude Code only and OpenAI/GPT-served
          models are Codex only.
        </p>
      </div>
      <p><a href="/harnesses">Browse harnesses →</a></p>
    </div>
    <div class="grid grid--2">
      {
        catalog.harnesses.map((harness) => (
          <a class="card" href={harnessHref(harness.harnessId)}>
            <h3>{harness.name}</h3>
            <p>{formatNumber(providersByHarness(harness.harnessId).size)} linked providers</p>
            <p class="small muted">{harness.vendor ?? 'Vendor unknown'}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section grid grid--2" aria-label="Catalog scope">
    <div class="card">
      <h2>What is in this snapshot</h2>
      <p>
        Provider names, API metadata, model limits, capabilities, modalities, pricing and
        open-weight status come from the public models.dev catalog. Canonical model ids correlate
        the same release across providers; harness links, the family tree and benchmark
        definitions are curated in the catalog package.
      </p>
      <p>
        {formatNumber(openWeightModels)} models are marked open-weight. That is a model property, not
        a claim that a particular local runtime or machine can run it.
      </p>
    </div>
    <div class="card">
      <h2>What is deliberately empty</h2>
      <p>
        No subscription plan, recurring free allowance, local hardware requirement or benchmark
        score is published yet. Those facts need an approved source; this site does not infer them
        from a zero token price or a community claim.
      </p>
      <p><a href="/about">Read the data policy →</a></p>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>('[data-provider-search]')
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-provider-card]'))
    const empty = document.querySelector<HTMLElement>('[data-provider-empty]')

    function updateProviders() {
      const query = (search?.value ?? '').trim().toLowerCase()
      let visible = 0
      for (const card of cards) {
        const matches = query === '' || (card.dataset.name ?? '').includes(query)
        card.hidden = !matches
        if (matches) visible += 1
      }
      if (empty) empty.hidden = visible !== 0
    }

    search?.addEventListener('input', updateProviders)
  </script>
</Base>
