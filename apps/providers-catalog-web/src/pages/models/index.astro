---
import Base from '../../layouts/Base.astro'
import {
  companyContextForProvider,
  familyPath,
  harnessesForProvider,
  loadCatalog,
} from '../../lib/catalog'
import {
  canonicalHref,
  familyHref,
  formatContext,
  formatDate,
  formatModalities,
  formatNumber,
  modelHref,
} from '../../lib/format'

const catalog = await loadCatalog()
const providers = catalog.providers
const models = catalog.models
const modalities = ['text', 'image', 'audio', 'video', 'pdf']
const families = [...catalog.families].sort((left, right) => left.name.localeCompare(right.name))
const harnessesFor = new Map(
  providers.map((provider) => [
    provider.providerId,
    harnessesForProvider(catalog, provider.providerId).map((harness) => harness.harnessId),
  ]),
)
const familyNames = new Map(catalog.families.map((family) => [family.familyId, family.name]))
const companyContexts = new Map(
  providers.map((provider) => [
    provider.providerId,
    companyContextForProvider(catalog, provider.providerId),
  ]),
)
---

<Base
  title="Models"
  description="Filter coding-agent models by provider, harness, family, context, modality and local weights."
>
  <header class="page-header">
    <p class="eyebrow">Model browser</p>
    <h1>Models in this snapshot</h1>
    <p class="lede">
      {formatNumber(models.length)} provider model entries across {formatNumber(providers.length)}
      providers, correlated into {formatNumber(catalog.canonicalModels.length)} canonical models and
      {formatNumber(catalog.families.length)} families. Filters run in your browser over this build's
      static data. No request leaves the page.
    </p>
    <div class="meta-row">
      <span class="pill">Snapshot {formatDate(catalog.snapshot.generatedAt)}</span>
      <span class="pill">Plans and offers not published</span>
      <span class="pill">Zero price is not a free offer</span>
    </div>
  </header>

  <div class="filters" aria-label="Model filters">
    <label class="filter-field">
      <span>Search</span>
      <input data-filter="q" type="search" placeholder="Model or provider" autocomplete="off" />
    </label>

    <label class="filter-field">
      <span>Provider</span>
      <select data-filter="provider">
        <option value="">All providers</option>
        {
          providers.map((provider) => {
            const context = companyContexts.get(provider.providerId)
            return (
              <option value={provider.providerId}>
                {provider.name}
                {context ? ` — ${context.company.name} plan` : ''}
              </option>
            )
          })
        }
      </select>
    </label>

    <label class="filter-field">
      <span>Harness</span>
      <select data-filter="harness">
        <option value="">All harnesses</option>
        {catalog.harnesses.map((harness) => <option value={harness.harnessId}>{harness.name}</option>)}
      </select>
      <span class="filter-note">Only providers linked to the harness match.</span>
    </label>

    <label class="filter-field">
      <span>Family</span>
      <select data-filter="family">
        <option value="">All families</option>
        {families.map((family) => <option value={family.familyId}>{family.name}</option>)}
      </select>
      <span class="filter-note">A parent family includes its descendant families.</span>
    </label>

    <label class="filter-field">
      <span>Offer status</span>
      <select data-filter="offer" disabled>
        <option value="">No plan source is published</option>
      </select>
      <span class="filter-note">No plan or recurring offer has a source yet.</span>
    </label>

    <label class="filter-field">
      <span>Minimum context</span>
      <input data-filter="context" type="number" min="0" step="1000" placeholder="Any" />
    </label>

    <label class="filter-field">
      <span>Input modality</span>
      <select data-filter="modality">
        <option value="">Any modality</option>
        {modalities.map((modality) => <option value={modality}>{modality}</option>)}
      </select>
    </label>

    <label class="filter-field">
      <span>Local weights</span>
      <select data-filter="local">
        <option value="">Any</option>
        <option value="yes">Open weights</option>
        <option value="no">Hosted only</option>
        <option value="unknown">Unknown</option>
      </select>
    </label>

    <div class="filter-actions">
      <button class="button" type="button" data-reset>Reset filters</button>
    </div>
  </div>

  <div class="table-toolbar">
    <p data-result-count>{formatNumber(models.length)} models</p>
  </div>

  <p class="empty" data-model-empty hidden>No models match these filters.</p>

  <div class="table-wrap">
    <table>
      <caption class="visually-hidden">Models from the current providers catalog snapshot</caption>
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col">Provider</th>
          <th scope="col">Harness</th>
          <th scope="col">Family</th>
          <th scope="col">Context</th>
          <th scope="col">Input</th>
          <th scope="col">Local</th>
          <th scope="col">Offer</th>
        </tr>
      </thead>
      <tbody>
        {
          models.map((model) => {
            const companyContext = companyContexts.get(model.providerId)
            const local = model.openWeights === true ? 'yes' : model.openWeights === false ? 'no' : 'unknown'
            const providerHarnesses = harnessesFor.get(model.providerId) ?? []
            const familyIds = familyPath(catalog, model.familyId).map((family) => family.familyId)
            return (
              <tr
                data-model-row
                data-provider={model.providerId}
                data-harnesses={providerHarnesses.join(' ')}
                data-families={familyIds.join(' ')}
                data-offer="unknown"
                data-context={model.contextLimit ?? 0}
                data-modalities={(model.modalitiesInput ?? []).join(' ')}
                data-local={local}
                data-search={`${model.name ?? ''} ${model.modelId} ${model.providerName} ${model.providerId} ${model.canonicalModelId} ${companyContext?.plan.name ?? ''} ${companyContext?.company.name ?? ''}`.toLowerCase()}
              >
                <td>
                  <a href={modelHref(model.providerId, model.modelId)}>
                    {model.name ?? model.modelId}
                  </a>
                  <div class="mono subtle">{model.modelId}</div>
                </td>
                <td>
                  {model.providerName}
                  {companyContext && (
                    <div class="small muted">
                      {companyContext.plan.name} plan of {companyContext.company.name}
                    </div>
                  )}
                </td>
                <td>
                  {providerHarnesses.length > 0
                    ? providerHarnesses
                        .map((harnessId) => catalog.harnesses.find((harness) => harness.harnessId === harnessId)?.name ?? harnessId)
                        .join(', ')
                    : 'Any'}
                </td>
                <td>
                  <a href={familyHref(model.familyId)}>
                    {familyNames.get(model.familyId) ?? model.familyId}
                  </a>
                  <div class="mono subtle">
                    <a href={canonicalHref(model.canonicalModelId)}>{model.canonicalModelId}</a>
                  </div>
                </td>
                <td>{formatContext(model.contextLimit)}</td>
                <td>{formatModalities(model.modalitiesInput)}</td>
                <td>{local}</td>
                <td>Unknown</td>
              </tr>
            )
          })
        }
      </tbody>
    </table>
  </div>

  <noscript>
    <p class="noscript">
      All models are listed above without JavaScript. Client-side filters and comparison need
      JavaScript; use the provider pages for a smaller view.
    </p>
  </noscript>

  <script>
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-model-row]'))
    const resultCount = document.querySelector<HTMLElement>('[data-result-count]')
    const empty = document.querySelector<HTMLElement>('[data-model-empty]')

    function filterValue(name: string): string {
      const element = document.querySelector<HTMLInputElement | HTMLSelectElement>(
        `[data-filter="${name}"]`,
      )
      return element?.value.trim() ?? ''
    }

    function applyFilters() {
      const query = filterValue('q').toLowerCase()
      const provider = filterValue('provider')
      const harness = filterValue('harness')
      const family = filterValue('family')
      const context = Number(filterValue('context') || 0)
      const modality = filterValue('modality')
      const local = filterValue('local')

      let visible = 0
      for (const row of rows) {
        const matches =
          (query === '' || (row.dataset.search ?? '').includes(query)) &&
          (provider === '' || row.dataset.provider === provider) &&
          (harness === '' || (row.dataset.harnesses ?? '').split(' ').includes(harness)) &&
          (family === '' || (row.dataset.families ?? '').split(' ').includes(family)) &&
          (context === 0 || Number(row.dataset.context ?? 0) >= context) &&
          (modality === '' || (row.dataset.modalities ?? '').split(' ').includes(modality)) &&
          (local === '' || row.dataset.local === local)

        row.hidden = !matches
        if (matches) visible += 1
      }

      if (resultCount) {
        resultCount.textContent = `${visible.toLocaleString()} of ${rows.length.toLocaleString()} models`
      }
      if (empty) empty.hidden = visible !== 0
    }

    for (const element of document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      '[data-filter]',
    )) {
      element.addEventListener('input', applyFilters)
      element.addEventListener('change', applyFilters)
    }

    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      for (const element of document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
        '[data-filter]',
      )) {
        if (!(element as HTMLSelectElement).disabled) element.value = ''
      }
      applyFilters()
    })

    applyFilters()
  </script>
</Base>
