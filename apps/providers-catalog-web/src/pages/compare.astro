---
import Base from '../layouts/Base.astro'
import { loadCatalog } from '../lib/catalog'
import { buildComparisonModels } from '../lib/compare'

const catalog = await loadCatalog()
const summariesJson = JSON.stringify(buildComparisonModels(catalog)).replace(/</g, '\\u003c')
---

<Base
  title="Compare models"
  description="Compare selected models from the current catalog snapshot side by side."
>
  <header class="page-header">
    <p class="eyebrow">Comparison</p>
    <h1>Compare models</h1>
    <p class="lede">
      Select models from the model browser to compare context, limits, modalities, pricing,
      plan and offer facts, local runtimes and provenance. The comparison runs over this build's
      static data.
    </p>
    <p class="small muted">
      No verified plans, recurring free offers or local runtimes are published yet, so those
      fields stay unknown rather than being shown as zero or free.
    </p>
    <p><a href="/models">Choose models →</a></p>
  </header>

  <div id="compare-root" aria-live="polite">
    <noscript>
      <p class="noscript">
        Comparison needs JavaScript. The model browser lists every model without JavaScript.
      </p>
    </noscript>
  </div>

  <script type="application/json" id="catalog-model-data" set:html={summariesJson}></script>
  <script>
    type LinkEntry = {
      sourceName: string
      sourceUrl: string
    }

    type Plan = LinkEntry & {
      name: string
      usageModel: string
    }

    type Offer = LinkEntry & {
      allowance: number
      allowanceUnit: string
      resetPeriod: string
      conditions: string | null
    }

    type Runtime = LinkEntry & {
      runtime: string
      quantization: string | null
      approximateHardware: string | null
    }

    type Summary = {
      key: string
      href: string
      providerName: string
      name: string | null
      modelId: string
      modelType: string | null
      canonicalModelId: string | null
      contextLimit: number | null
      inputLimit: number | null
      outputLimit: number | null
      modalitiesInput: string[] | null
      modalitiesOutput: string[] | null
      openWeights: boolean | null
      costInput: number | null
      costOutput: number | null
      costCacheRead: number | null
      costCacheWrite: number | null
      sourceName: string
      sourceUrl: string
      sourceRecord: string
      verifiedAt: string
      confidence: string
      plans: Plan[]
      offers: Offer[]
      localRuntimes: Runtime[]
    }

    const dataElement = document.getElementById('catalog-model-data')
    const root = document.getElementById('compare-root')
    const summaries: Summary[] = dataElement?.textContent ? JSON.parse(dataElement.textContent) : []
    const keys = (new URLSearchParams(window.location.search).get('models') ?? '')
      .split(',')
      .map((key) => key.trim())
      .filter(Boolean)
    const selected = keys
      .map((key) => summaries.find((summary) => summary.key === key))
      .filter((summary): summary is Summary => summary !== undefined)

    function text(value: string | null): string {
      return value ?? 'Unknown'
    }

    function formatNumber(value: number | null): string {
      return value === null ? 'Unknown' : new Intl.NumberFormat('en-US').format(value)
    }

    function formatCost(value: number | null): string {
      return value === null ? 'Unknown' : `$${value.toFixed(2)}`
    }

    function formatBoolean(value: boolean | null): string {
      return value === null ? 'Unknown' : value ? 'Yes' : 'No'
    }

    function formatModalities(value: string[] | null): string {
      return value && value.length > 0 ? value.join(', ') : 'Unknown'
    }

    function cell(content: string): HTMLTableCellElement {
      const element = document.createElement('td')
      element.textContent = content
      return element
    }

    function date(value: string): string {
      const parsed = new Date(value)
      return Number.isNaN(parsed.getTime())
        ? value
        : new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' }).format(parsed)
    }

    function renderEmpty() {
      if (!root) return
      const empty = document.createElement('div')
      empty.className = 'empty'
      const heading = document.createElement('h2')
      heading.textContent = 'No models selected'
      const copy = document.createElement('p')
      copy.textContent = 'Open the model browser, select one or more models, then choose Compare selected.'
      const link = document.createElement('p')
      const anchor = document.createElement('a')
      anchor.href = '/models'
      anchor.textContent = 'Choose models →'
      link.append(anchor)
      empty.append(heading, copy, link)
      root.replaceChildren(empty)
    }

    function renderComparison() {
      if (!root) return
      if (selected.length === 0) {
        renderEmpty()
        return
      }

      const table = document.createElement('table')
      const caption = document.createElement('caption')
      caption.className = 'visually-hidden'
      caption.textContent = 'Selected model comparison'
      table.append(caption)

      const thead = document.createElement('thead')
      const headRow = document.createElement('tr')
      const fieldHead = document.createElement('th')
      fieldHead.scope = 'col'
      fieldHead.textContent = 'Field'
      headRow.append(fieldHead)
      for (const model of selected) {
        const head = document.createElement('th')
        head.scope = 'col'
        const link = document.createElement('a')
        link.href = model.href
        link.textContent = text(model.name ?? model.modelId)
        head.append(link)
        headRow.append(head)
      }
      thead.append(headRow)
      table.append(thead)

      const fields: Array<[string, (model: Summary) => string]> = [
        ['Provider', (model) => model.providerName],
        ['Model id', (model) => model.modelId],
        ['Canonical id', (model) => text(model.canonicalModelId)],
        ['Type', (model) => text(model.modelType)],
        ['Context', (model) => formatNumber(model.contextLimit)],
        ['Input limit', (model) => formatNumber(model.inputLimit)],
        ['Output limit', (model) => formatNumber(model.outputLimit)],
        ['Input modalities', (model) => formatModalities(model.modalitiesInput)],
        ['Output modalities', (model) => formatModalities(model.modalitiesOutput)],
        ['Open weights', (model) => formatBoolean(model.openWeights)],
        ['Input cost / 1M', (model) => formatCost(model.costInput)],
        ['Output cost / 1M', (model) => formatCost(model.costOutput)],
        ['Cache read / 1M', (model) => formatCost(model.costCacheRead)],
        ['Cache write / 1M', (model) => formatCost(model.costCacheWrite)],
        [
          'Plan usage model',
          (model) =>
            model.plans.length > 0
              ? model.plans.map((plan) => `${plan.name}: ${plan.usageModel}`).join('; ')
              : 'Unknown — no verified plan',
        ],
        [
          'Recurring free allowance',
          (model) =>
            model.offers.length > 0
              ? model.offers
                  .map(
                    (offer) =>
                      `${formatNumber(offer.allowance)} ${offer.allowanceUnit} / ${offer.resetPeriod}`,
                  )
                  .join('; ')
              : 'Unknown — no verified recurring offer',
        ],
        [
          'Offer conditions',
          (model) =>
            model.offers.length > 0
              ? model.offers
                  .map((offer) => offer.conditions)
                  .filter((conditions): conditions is string => conditions !== null)
                  .join('; ') || 'No conditions published'
              : 'Unknown — no verified recurring offer',
        ],
        [
          'Local runtime',
          (model) =>
            model.localRuntimes.length > 0
              ? model.localRuntimes
                  .map((runtime) =>
                    runtime.quantization
                      ? `${runtime.runtime} (${runtime.quantization})`
                      : runtime.runtime,
                  )
                  .join('; ')
              : 'Unknown — no verified local runtime',
        ],
        [
          'Local hardware',
          (model) =>
            model.localRuntimes.length > 0
              ? model.localRuntimes
                  .map((runtime) => runtime.approximateHardware)
                  .filter((hardware): hardware is string => hardware !== null)
                  .join('; ') || 'Unknown'
              : 'Unknown — no verified local runtime',
        ],
        ['Verified', (model) => date(model.verifiedAt)],
        ['Confidence', (model) => model.confidence],
      ]

      const tbody = document.createElement('tbody')
      for (const [label, value] of fields) {
        const row = document.createElement('tr')
        const heading = document.createElement('th')
        heading.scope = 'row'
        heading.textContent = label
        row.append(heading)
        for (const model of selected) {
          row.append(cell(value(model)))
        }
        tbody.append(row)
      }

      const linkFields: Array<[string, (model: Summary) => LinkEntry[], string]> = [
        ['Plan source', (model) => model.plans, 'Unknown — no verified plan'],
        ['Offer source', (model) => model.offers, 'Unknown — no verified recurring offer'],
        [
          'Local runtime source',
          (model) => model.localRuntimes,
          'Unknown — no verified local runtime',
        ],
      ]

      for (const [label, entries, fallback] of linkFields) {
        const row = document.createElement('tr')
        const heading = document.createElement('th')
        heading.scope = 'row'
        heading.textContent = label
        row.append(heading)
        for (const model of selected) {
          const sourceCell = document.createElement('td')
          const seen = new Set<string>()
          const unique = entries(model).filter((entry) => {
            if (seen.has(entry.sourceUrl)) return false
            seen.add(entry.sourceUrl)
            return true
          })
          if (unique.length === 0) {
            sourceCell.textContent = fallback
          } else {
            unique.forEach((entry, index) => {
              if (index > 0) sourceCell.append('; ')
              const link = document.createElement('a')
              link.href = entry.sourceUrl
              link.target = '_blank'
              link.rel = 'noreferrer'
              link.textContent = entry.sourceName
              sourceCell.append(link)
            })
          }
          row.append(sourceCell)
        }
        tbody.append(row)
      }

      const sourceRow = document.createElement('tr')
      const sourceHeading = document.createElement('th')
      sourceHeading.scope = 'row'
      sourceHeading.textContent = 'Source'
      sourceRow.append(sourceHeading)
      for (const model of selected) {
        const sourceCell = document.createElement('td')
        const link = document.createElement('a')
        link.href = model.sourceUrl
        link.target = '_blank'
        link.rel = 'noreferrer'
        link.textContent = model.sourceName
        sourceCell.append(link)
        sourceRow.append(sourceCell)
      }
      tbody.append(sourceRow)
      table.append(tbody)

      const wrapper = document.createElement('div')
      wrapper.className = 'table-wrap'
      wrapper.append(table)
      const note = document.createElement('p')
      note.className = 'small muted'
      note.textContent =
        'Values are from the current snapshot. Missing values are shown as Unknown, not as zero. Allowances and prices are sourced observations that can change; no quota is guaranteed.'
      root.replaceChildren(wrapper, note)
    }

    renderComparison()
  </script>
</Base>
