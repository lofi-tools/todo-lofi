---
import { loadCatalog, type CatalogSource } from '../lib/catalog'
import type { Confidence, ScrapeStatus } from '../types'
import { formatDateTime } from '../lib/format'

interface Props {
  sourceId: string
  sourceUrl: string
  sourceRecord: string
  verifiedAt: string
  confidence: Confidence
  scrapeStatus: ScrapeStatus
}

const { sourceId, sourceUrl, sourceRecord, verifiedAt, confidence, scrapeStatus } = Astro.props
const catalog = await loadCatalog()
const source: CatalogSource | undefined = catalog.snapshot.sources.find(
  (entry) => entry.sourceId === sourceId,
)
---

<section class="provenance" aria-label="Provenance">
  <h2>Provenance</h2>
  <dl>
    <div>
      <dt>Source</dt>
      <dd>
        {
          source ? (
            <a href={source.sourceUrl} target="_blank" rel="noreferrer">
              {source.name}
            </a>
          ) : (
            <a href={sourceUrl} target="_blank" rel="noreferrer">
              {sourceUrl}
            </a>
          )
        }
      </dd>
    </div>
    <div>
      <dt>Source record</dt>
      <dd><code class="mono">{sourceRecord}</code></dd>
    </div>
    <div>
      <dt>License</dt>
      <dd>{source?.license ?? 'Unknown'}</dd>
    </div>
    <div>
      <dt>Attribution</dt>
      <dd>{source?.attribution ?? 'Unknown'}</dd>
    </div>
    <div>
      <dt>Source fetched</dt>
      <dd>{source ? formatDateTime(source.fetchedAt) : 'Unknown'}</dd>
    </div>
    <div>
      <dt>Last verified</dt>
      <dd>{formatDateTime(verifiedAt)}</dd>
    </div>
    <div>
      <dt>Confidence / status</dt>
      <dd>{confidence} / {scrapeStatus}</dd>
    </div>
  </dl>
</section>
