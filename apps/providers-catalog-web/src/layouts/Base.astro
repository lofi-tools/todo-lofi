---
import 'styled-system/styles.css'
import 'web-design-system/styles.css'
import '../styles/catalog.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { loadCatalog } from '../lib/catalog'

interface Props {
  title: string
  description?: string
}

const { title, description = 'A sourced catalog of coding-agent providers and models.' } = Astro.props
const catalog = await loadCatalog()
const { snapshot } = catalog
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/catalog.svg" />
    <title>{title} · Providers catalog</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      ;(function () {
        try {
          var stored = localStorage.getItem('wds-theme')
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored
          }
        } catch (error) {
          /* storage unavailable: keep the dark default */
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    {
      snapshot.stale && (
        <div class="banner" role="status">
          <div class="banner__inner">
            This snapshot is {snapshot.ageDays.toFixed(1)} days old. Values are the last
            verified observation and may have changed.
          </div>
        </div>
      )
    }
    <main id="content" class="container">
      <slot />
    </main>
    <SiteFooter snapshot={snapshot} />
  </body>
</html>
