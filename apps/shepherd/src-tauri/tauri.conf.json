{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shepherd",
  "version": "0.1.0",
  "identifier": "dev.shepherd.shell",
  "build": {
    "beforeDevCommand": "pnpm --dir ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui run build",
    "frontendDist": "../ui/dist",
    "additionalWatchFolders": ["../ui"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shepherd",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 19 },
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}
