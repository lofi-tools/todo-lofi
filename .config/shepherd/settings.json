{
  "version": 1,
  "settings": {
    "worktree.setup": {
      "useImportedSetup": false,
      "afterCheckout": [
        {
          "name": "Allow direnv in the worktree",
          "command": ["direnv", "allow", "."]
        }
      ],
      "launchWrapper": ["direnv", "exec", "."]
    }
  }
}
