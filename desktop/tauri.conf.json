{
  "productName": "TodoLofi",
  "version": "0.1.0",
  "identifier": "com.todolofi.app",
  "build": {
    "beforeBuildCommand": "cargo build",
    "beforeDevCommand": "cargo build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "shortDescription": "",
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
